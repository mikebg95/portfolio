{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --ignore-lock",
      "startServerReadyPattern": "localhost:4321",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:4321/",
        "http://localhost:4321/experience/",
        "http://localhost:4321/projects/jamigos/",
        "http://localhost:4321/education/",
        "http://localhost:4321/nl/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
