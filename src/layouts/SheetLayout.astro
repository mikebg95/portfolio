---
import FontPreload from '../components/FontPreload.astro';
import SheetFrame from '../components/SheetFrame.astro';
import SheetHeader from '../components/SheetHeader.astro';
import TitleBlock from '../components/TitleBlock.astro';
import { SITE_URL } from '../config';
import type { SheetKey } from '../content/schemas';
import { t } from '../i18n/content';
import type { Lang } from '../i18n/paths';
import { OG_HEIGHT, ogImagePath, OG_WIDTH } from '../og';
import { absoluteUrl, alternates, neutralPath } from '../seo';
import { THEME_STORAGE_KEY, THEMES } from '../theme';
import '../styles/base.css';

// The page shell every route uses: theme before paint, skip link, the sheet frame, the header and
// the title block footer. SPEC §3.8: title, description, canonical, hreflang, Open Graph text and
// image (src/pages/og/) and the Twitter card in the head; a page adds more (Sheet 01's JSON-LD)
// through the `head` slot.
interface Props {
  lang: Lang;
  title: string;
  /** design/copy.md SEO; the 404 sheets have none. */
  description?: string;
  /** The 404 sheets: served at any unknown URL, so no canonical or alternates, and not indexed. */
  noindex?: boolean;
  /** The sheet this page belongs to (its header tab is current, its number in the title block);
   * omitted on the 404 sheet. */
  sheet?: SheetKey;
}

const { lang, title, description, sheet, noindex = false } = Astro.props;
const ui = await t(lang);
const { path } = neutralPath(Astro.url.pathname);
const canonical = noindex ? undefined : absoluteUrl(SITE_URL, lang, path);
const ogImage = new URL(ogImagePath(lang, path), SITE_URL).href;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- SPEC §3.3: apply a remembered theme before first paint; no choice → CSS follows the system. -->
    <script is:inline define:vars={{ key: THEME_STORAGE_KEY, themes: THEMES }}>
      try {
        const theme = localStorage.getItem(key);
        if (themes.includes(theme)) document.documentElement.dataset.theme = theme;
      } catch {
        // Storage blocked: follow the system.
      }
    </script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical &&
      alternates(SITE_URL, path).map(({ hreflang, href }) => (
        <link rel="alternate" hreflang={hreflang} href={href} />
      ))}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={new URL(SITE_URL).host} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />
    <FontPreload />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {ui.skipLink}
    </a>
    <SheetFrame>
      <SheetHeader slot="header" lang={lang} sheet={sheet} />
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <TitleBlock slot="footer" lang={lang} sheet={sheet} />
    </SheetFrame>
  </body>
</html>

<style>
  /* components.md SkipLink: hidden until focused, then an ink button top-left. */
  .skip-link {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 10;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-3) var(--space-5);
    background: var(--color-ink);
    color: var(--color-ink-on-fill);
    font-family: var(--font-mono);
    font-size: var(--size-small);
    letter-spacing: 0.04em;
    text-decoration: none;
    transform: translateY(calc(-100% - var(--space-4)));
  }

  .skip-link:focus {
    transform: none;
  }

  main:focus {
    outline: none;
  }
</style>
