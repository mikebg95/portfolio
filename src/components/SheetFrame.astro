---
import Crosshair from './Crosshair.astro';

// The drawing sheet (SPEC §3.1, components.md SheetFrame): desk → paper with the 16/80 px grid,
// 2 px outer frame, 10 px gap, 1 px inner frame (phone: the outer frame only), zone strip 1–8 on
// desktop, then the slots.
const ZONES = [1, 2, 3, 4, 5, 6, 7, 8];
const EDGES = ['top', 'right', 'bottom', 'left'];
---

<div class="desk">
  <div class="sheet">
    <!-- The first-load plotting's grid and frame edges (motion.md §M1, src/styles/plotting.css);
         not rendered anywhere else. -->
    <div class="sheet__plot" aria-hidden="true">
      <span class="sheet__plot-grid"></span>
      {EDGES.map((edge) => (
        <span class:list={['sheet__plot-edge', `sheet__plot-edge--${edge}`]} />
      ))}
    </div>
    <Crosshair />
    <div class="sheet__inner">
      <div class="sheet__zones" aria-hidden="true">
        {ZONES.map((zone) => (
          <span>{zone}</span>
        ))}
      </div>
      <slot name="header" />
      <slot />
      <slot name="footer" />
    </div>
  </div>
</div>

<style>
  .desk {
    padding: var(--sheet-outer-padding);
  }

  .sheet {
    position: relative;
    max-width: var(--sheet-max-width);
    margin: 0 auto;
    padding: var(--sheet-frame-gap);
    border: var(--sheet-frame-outer) solid var(--color-ink);
    background-color: var(--color-paper);
    background-image:
      linear-gradient(var(--color-grid-major) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-grid-major) 1px, transparent 1px),
      linear-gradient(var(--color-grid-minor) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-grid-minor) 1px, transparent 1px);
    background-size:
      var(--sheet-grid-major) var(--sheet-grid-major),
      var(--sheet-grid-major) var(--sheet-grid-major),
      var(--sheet-grid-minor) var(--sheet-grid-minor),
      var(--sheet-grid-minor) var(--sheet-grid-minor);
  }

  .sheet__plot {
    display: none;
  }

  .sheet__inner {
    position: relative;
    border: var(--sheet-frame-inner) solid var(--color-ink);
  }

  .sheet__zones {
    display: none;
    justify-content: space-around;
    padding: 3px 0;
    border-bottom: var(--border-thin);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--size-micro);
    line-height: normal;
  }

  /* Phone (the 390 px drawings): no desk, the sheet is the screen with only its 2 px outer frame.
     With no desk to land on, what draws past the screen edge (Sheet 01's revision note stamps in at
     1.25×) is clipped there rather than letting the page pan sideways. */
  @media (max-width: 767px) {
    .desk {
      padding: var(--sheet-outer-padding-phone);
      overflow-x: clip;
    }

    .sheet {
      padding: 0;
    }

    .sheet__inner {
      border: none;
    }
  }

  @media (min-width: 1024px) {
    .sheet__zones {
      display: flex;
    }
  }
</style>
