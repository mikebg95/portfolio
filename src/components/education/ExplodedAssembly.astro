---
import type { CollectionEntry } from 'astro:content';

import { explode, layout, TILT_DEG, type Window } from '../../assembly';
import Balloon from '../drawing/Balloon.astro';

// components.md ExplodedAssembly (SPEC §4.6): the five education plates on a dashed centre axis,
// each with a leader and balloon. Plates, balloons and callouts carry `data-part`; plates and
// balloons are buttons named `name(part)`;
// `selected` is drawn pressed (balloon filled, label bold). Geometry in drawing units from
// src/assembly.ts, scaled by `--u` so the drawing fits the column beside a fixed label width.
// motion.md §M5: each plate carries its assembled offset (`--drop`) and explosion schedule
// (`data-move/-callout/-fade`, from `explode`), which src/assembly-motion.ts plays.
interface Props {
  parts: CollectionEntry<'education'>['data'][];
  selected: number;
  /** Accessible name of a part's plate and balloon. */
  name: (part: CollectionEntry<'education'>['data']) => string;
  label: string;
}

const { parts, selected, name, label } = Astro.props;
const assembly = layout(parts);
const explosion = explode(assembly);
const windowOf = (window: Window | null) => window?.join(' ');

// As drawn: the base plate on paper, the next three on fill-1, -2, -3; CKAD is dashed redline.
const FILLS = ['paper', 'fill-1', 'fill-2', 'fill-3'];
const fill = (item: number) => `var(--color-${FILLS[item - 1] ?? 'paper'})`;
---

<div
  class="assembly"
  data-scrub="pending"
  role="group"
  aria-label={label}
  style={`--tilt: ${TILT_DEG}deg; --width: ${assembly.balloon}; --height: ${assembly.height}`}
>
  <div class="assembly__drawing">
    <span class="assembly__axis" style={`--x: ${assembly.axis}`} aria-hidden="true"></span>
    {assembly.plates.map(({ part, side, cx, cy, right }, i) => (
      <>
        <button
          type="button"
          class:list={['plate', `plate--${part.plate.style}`, `plate--${part.plate.size}`]}
          style={`--x: ${cx - side / 2}; --y: ${cy - side / 2}; --side: ${side}; --fill: ${fill(part.item)}; --drop: ${explosion[i]?.drop ?? 0}`}
          aria-label={name(part)}
          aria-pressed={part.item === selected ? 'true' : 'false'}
          data-part={part.item}
          data-move={windowOf(explosion[i]?.move ?? null)}
          data-callout={windowOf(explosion[i]?.callout ?? null)}
          data-fade={windowOf(explosion[i]?.fade ?? null)}
        />
        <span
          class:list={[
            'assembly__callout',
            part.item === selected && 'assembly__callout--selected',
            part.pending && 'assembly__callout--pending',
          ]}
          style={`--x: ${right}; --y: ${cy}; --leader: ${assembly.balloon - right}`}
          data-part={part.item}
        >
          <Balloon
            as="button"
            number={part.item}
            leader="left"
            state={part.pending ? 'pending' : part.item === selected ? 'active' : 'default'}
            label={name(part)}
            aria-pressed={part.item === selected ? 'true' : 'false'}
            data-part={part.item}
          />
          <span class="assembly__label" aria-hidden="true">
            {part.balloon}
          </span>
        </span>
      </>
    ))}
  </div>
</div>

<script>
  import { SCRUB_ATTR, startScrub } from '../../scrub';

  for (const assembly of document.querySelectorAll<HTMLElement>(`.assembly[${SCRUB_ATTR}]`)) {
    startScrub(assembly, () => import('../../assembly-motion'));
  }
</script>

<style>
  /* The drawing scales (--u, px per drawing unit) to the width left after the label column. */
  .assembly {
    --labels: 190px;

    container-type: inline-size;
  }

  .assembly__drawing {
    --u: min(1px, (100cqi - var(--labels)) / var(--width));

    position: relative;
    width: calc(var(--width) * var(--u) + var(--labels));
    height: calc(var(--height) * var(--u));
    margin-inline: auto;
  }

  .assembly__axis {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--x) * var(--u));
    border-left: 1.5px dashed color-mix(in srgb, var(--color-ink) 45%, transparent);
    transform-origin: center bottom;
  }

  /* A square turned flat: the transform draws the diamond and turns the shadow into thickness. */
  .plate {
    position: absolute;
    top: calc(var(--y) * var(--u));
    left: calc(var(--x) * var(--u));
    width: calc(var(--side) * var(--u));
    height: calc(var(--side) * var(--u));
    padding: 0;
    border: var(--border-normal);
    background: var(--fill);
    opacity: var(--shown, 1);
    transform: translateY(var(--lift, 0px)) rotateX(var(--tilt)) rotateZ(-45deg);
    cursor: pointer;
  }

  .plate--full.plate--solid {
    box-shadow: var(--shadow-plate);
  }

  .plate--dashed {
    border: var(--border-dashed-note);
    background: var(--color-redline-tint);
  }

  /* motion.md §M5: once a part is chosen (data-active, set by the page script) its plate lifts
     12 px and fills, the other parts dim; hovering a parts-list row previews the lift. */
  .plate--preview,
  .assembly[data-active] .plate[aria-pressed='true'] {
    --lift: -12px;
  }

  .assembly[data-active] .plate[aria-pressed='true'] {
    background: color-mix(in srgb, var(--color-line) 25%, var(--color-paper));
  }

  .assembly[data-active] .plate[aria-pressed='false'],
  .assembly[data-active] .assembly__callout:not(.assembly__callout--selected) {
    opacity: calc(0.6 * var(--shown, 1));
  }

  /* Transitions only once the page script marks the drawing ready: the stylesheets can land after
     a first style pass, and the plates would otherwise animate into their tilt on load. */
  .assembly[data-ready] .plate {
    transition:
      transform var(--motion-normal) var(--motion-ease-out),
      background-color var(--motion-normal) var(--motion-ease-out),
      opacity var(--motion-normal) var(--motion-ease-out);
  }

  .assembly[data-ready] .assembly__callout {
    transition: opacity var(--motion-normal) var(--motion-ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    .assembly[data-ready] .plate,
    .assembly[data-ready] .assembly__callout {
      transition: none;
    }
  }

  /* §M5 start state, until the explosion is done (docs/conventions/motion.md): solid plates piled
     on the base (`translate`, so the selection's `transform` lift still works), the axis undrawn,
     callouts hidden, the dashed plate not yet there. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .assembly:not([data-scrub='done']) .plate {
      translate: 0 calc(var(--drop) * var(--u));
    }

    :global(.js) .assembly:not([data-scrub='done']) .plate--dashed {
      --shown: 0;
    }

    :global(.js) .assembly:not([data-scrub='done']) .assembly__axis {
      transform: scaleY(0);
    }

    :global(.js) .assembly:not([data-scrub='done']) :global(.balloon__leader) {
      transform: scaleX(0);
      transform-origin: left center;
    }

    :global(.js) .assembly:not([data-scrub='done']) :global(.balloon__mark) {
      transform: scale(0);
    }

    :global(.js) .assembly:not([data-scrub='done']) .assembly__label {
      opacity: 0;
    }
  }

  .assembly__callout {
    --balloon-leader: calc(var(--leader) * var(--u));

    position: absolute;
    top: calc(var(--y) * var(--u));
    left: calc(var(--x) * var(--u));
    display: flex;
    align-items: center;
    gap: 8px;
    width: calc(var(--leader) * var(--u) + var(--labels));
    transform: translateY(-50%);
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.3;
  }

  .assembly__callout--selected .assembly__label {
    font-weight: 600;
  }

  .assembly__callout--pending {
    color: var(--color-redline);
  }

  /* A long Dutch compound (Politicologie) is wider than the phone's label column: hyphenate it
     (the page's lang picks the dictionary), else break it, never spill past the sheet. */
  .assembly__label {
    min-width: 0;
    overflow-wrap: break-word;
    hyphens: auto;
  }

  @media (max-width: 767px) {
    .assembly {
      --labels: 112px;
    }

    .assembly__callout {
      gap: 6px;
      font-size: 11px;
    }
  }
</style>
