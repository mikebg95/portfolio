---
import type { CollectionEntry } from 'astro:content';

import { localize, type Lang } from '../../i18n/paths';
import { PORTRAIT, PORTRAIT_DARK } from '../../portrait';
import Balloon from '../drawing/Balloon.astro';
import DimensionLine from '../drawing/DimensionLine.astro';

// SPEC §4.1 portrait block: the ASCII portrait as real text in an aria-hidden <pre> (its
// description is sr-only text) — one per theme, CSS showing the theme's own, so it works without
// JS and never flashes the other — dimensioned across the top and down the left, with three
// ballooned callouts. Desktop: the callouts sit right of the portrait on leaders (as drawn);
// phone (overview-default-light-390): a framed FIG. 0 card, its balloons on the right edge and the
// callouts a 3-cell caption strip under it.
type Hero = CollectionEntry<'profile'>['data']['hero'];

interface Props {
  lang: Lang;
  dimensions: Hero['dimensions'];
  balloons: Hero['balloons'];
  alt: string;
  figure: Hero['figure'];
}

const { lang, dimensions, balloons, alt, figure } = Astro.props;
// The file's blank lead lines would only pad the frame (and a <pre> drops the first newline).
// One span per line, so §M1 can scan the portrait in line by line; the newlines stay between them.
const linesOf = (portrait: string) =>
  portrait
    .replace(/^(?:[ \t]*\n)+/, '')
    .trimEnd()
    .split('\n');
const versions = [
  { theme: 'paper', lines: linesOf(PORTRAIT) },
  { theme: 'blueprint', lines: linesOf(PORTRAIT_DARK) },
];
---

<figure class="portrait">
  <div class="portrait__drawing">
    <DimensionLine class="portrait__dim portrait__dim--h" label={dimensions.horizontal} />
    <DimensionLine
      class="portrait__dim portrait__dim--v"
      orientation="v"
      label={dimensions.vertical}
    />
    <div class="portrait__strip" aria-hidden="true">
      <span>{figure.label}</span>
      <span>{figure.scale}</span>
    </div>
    <div class="portrait__frame">
      {versions.map(({ theme, lines }) =>
        // prettier-ignore
        <pre class={`portrait__ascii portrait__ascii--${theme}`} aria-hidden="true">{lines.map((line, i) => <Fragment>{i ? '\n' : ''}<span class="portrait__line" style={`--line: ${i}`}>{line}</span></Fragment>)}</pre>,
      )}
      <figcaption class="sr-only">{alt}</figcaption>
    </div>
    <span class="portrait__edge" aria-hidden="true">
      {balloons.map((_, i) => (
        <Balloon number={i + 1} />
      ))}
    </span>
  </div>
  <ol class="portrait__callouts">
    {balloons.map((balloon, i) => (
      <li class="portrait__callout">
        {balloon.href ? (
          <a
            class="portrait__callout-body portrait__callout-link"
            href={localize(lang, balloon.href)}
          >
            <span class="portrait__leader" aria-hidden="true" />
            <Balloon number={i + 1} />
            <span class="portrait__callout-text">{balloon.text}</span>
          </a>
        ) : (
          <span class="portrait__callout-body">
            <span class="portrait__leader" aria-hidden="true" />
            <Balloon number={i + 1} />
            <span class="portrait__callout-text">{balloon.text}</span>
          </span>
        )}
      </li>
    ))}
  </ol>
</figure>

<style>
  /* Desktop geometry from the drawing: the portrait inset 44 px from the top and left for the
     dimension lines, 150 px from the right for the callouts, which start 30 px inside its frame.
     The block stretches to the hero's height, and the vertical dimension with it. */
  .portrait {
    --portrait-inset-top: 44px;
    --portrait-inset-left: 44px;
    --portrait-inset-right: 150px;
    --portrait-inset-bottom: 30px;
    /* The portrait's widest line, in characters; IBM Plex Mono advances 0.6 em. */
    --portrait-columns: 66;

    position: relative;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding-right: var(--portrait-inset-right);
  }

  .portrait__drawing {
    position: relative;
    flex: 1;
    padding: var(--portrait-inset-top) 0 var(--portrait-inset-bottom) var(--portrait-inset-left);
  }

  .portrait__dim--h {
    position: absolute;
    top: var(--space-2);
    right: 0;
    left: var(--portrait-inset-left);
  }

  .portrait__dim--v {
    position: absolute;
    top: var(--portrait-inset-top);
    bottom: var(--portrait-inset-bottom);
    left: var(--space-2);
    height: auto;
  }

  .portrait__ascii {
    margin: 0;
    padding: 14px 10px 0;
    overflow: hidden;
    border: var(--border-normal);
    background: var(--color-paper-raised);
    color: var(--color-line);
    font-family: var(--font-mono);
    font-size: 6.4px;
    line-height: 1.02;
  }

  /* One portrait per theme (src/portrait.ts): paper by default, blueprint where the page is —
     chosen, or the system's dark preference without a paper override (tokens.css). The theme's
     own stays in flow, sized as drawn; the other lies over it, hidden by visibility, not display,
     so both scan in together (§M1) and a theme switch mid-plot never restarts the scan. On the
     navy the brightest token, ink, reads as a lit face; line blue made it flat. */
  .portrait__frame {
    position: relative;
  }

  .portrait__ascii--blueprint,
  :global([data-theme='blueprint']) .portrait__ascii--paper {
    position: absolute;
    inset: 0;
    visibility: hidden;
  }

  .portrait__ascii--blueprint {
    color: var(--color-ink);
  }

  :global([data-theme='blueprint']) .portrait__ascii--blueprint {
    position: static;
    visibility: visible;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='paper'])) .portrait__ascii--paper {
      position: absolute;
      inset: 0;
      visibility: hidden;
    }

    :global(:root:not([data-theme='paper'])) .portrait__ascii--blueprint {
      position: static;
      visibility: visible;
    }
  }

  /* Inline-block so a line can be clipped (the §M1 scan) without changing the text or its rows. */
  .portrait__line {
    display: inline-block;
  }

  .portrait__callouts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .portrait__callout {
    position: absolute;
    right: 0;
    width: 180px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.35;
  }

  .portrait__callout:nth-child(1) {
    top: 70px;
  }

  .portrait__callout:nth-child(2) {
    top: 170px;
  }

  .portrait__callout:nth-child(3) {
    top: 270px;
  }

  .portrait__callout-body {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-ink);
  }

  /* components.md Leader: 1 px ink, from the portrait to the balloon. */
  .portrait__leader {
    flex: none;
    width: 34px;
    height: 1px;
    background: var(--color-ink);
  }

  .portrait__callout-text {
    /* Breaks each callout onto two lines as drawn ("Spring / certified"). */
    max-width: 10ch;
    /* …but never narrower than its longest word (Dutch "gecertificeerd" is 14 characters). */
    min-width: min-content;
  }

  .portrait__callout-link {
    text-decoration: none;
    transition: color var(--motion-fast) var(--motion-ease-out);
  }

  .portrait__callout-link:hover {
    color: var(--color-redline);
  }

  /* §M6: a link's balloon scales 1.08 on hover and keyboard focus. */
  .portrait__callout-link :global(.balloon__mark) {
    transition: transform var(--motion-fast) var(--motion-ease-pop);
  }

  .portrait__callout-link:is(:hover, :focus-visible) :global(.balloon__mark) {
    transform: scale(1.08);
  }

  @media (prefers-reduced-motion: reduce) {
    .portrait__callout-link,
    .portrait__callout-link :global(.balloon__mark) {
      transition: none;
    }
  }

  /* The phone card's title strip and edge balloons: drawn on the phone only. */
  .portrait__strip,
  .portrait__edge {
    display: none;
  }

  /* Phone (overview-default-light-390): the portrait is a framed FIG. 0 card the column's width —
     a title strip over it, balloons 1–3 on its right edge — and the callouts a 3-cell caption strip
     under it, numbered as the balloons. No dimension lines on the card, as drawn. */
  @media (max-width: 767px) {
    .portrait {
      width: 100%;
      padding-right: 0;
    }

    .portrait__drawing {
      padding: 0;
      border: var(--border-normal);
      background: var(--color-paper-raised);
    }

    /* Out-specifies DimensionLine's own display. */
    .portrait .portrait__dim {
      display: none;
    }

    .portrait__strip {
      display: flex;
      justify-content: space-between;
      gap: var(--space-3);
      padding: 7px 10px;
      border-bottom: var(--border-thin);
      color: var(--color-line);
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.1em;
      line-height: 1.4;
    }

    /* Size containment: the frame takes the card's width, never the portrait's. */
    .portrait__frame {
      container-type: inline-size;
    }

    /* Room on the right for the edge balloons, which sit 12 px into the card. */
    .portrait__ascii {
      --portrait-pad-left: 12px;
      --portrait-pad-right: 20px;

      padding: 14px var(--portrait-pad-right) 14px var(--portrait-pad-left);
      border: none;
      background: none;
      /* The font grows until the widest line fills the frame between the paddings. */
      font-size: calc(
        (100cqi - var(--portrait-pad-left) - var(--portrait-pad-right)) /
          (var(--portrait-columns) * 0.6)
      );
    }

    /* Centred on the card's right rule, spread down the portrait below the strip. */
    .portrait__edge {
      position: absolute;
      top: 28px;
      right: -0.75px;
      bottom: 0;
      display: flex;
      flex-direction: column;
      justify-content: space-evenly;
      transform: translateX(50%);
    }

    .portrait__callouts {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border: var(--border-normal);
      border-top: none;
      counter-reset: callout;
    }

    .portrait__callout {
      position: static;
      display: flex;
      width: auto;
      min-width: 0;
      font-size: 10.5px;
      counter-increment: callout;
    }

    .portrait__callout + .portrait__callout {
      border-left: var(--border-thin);
    }

    /* The whole cell is the target (44 px or more), the number drawn as the balloon's. */
    .portrait__callout-body {
      display: block;
      flex: 1;
      min-width: 0;
      min-height: 44px;
      padding: 9px 10px;
    }

    .portrait__callout-body::before {
      content: counter(callout) ' ';
      color: var(--color-line);
      font-weight: 600;
    }

    .portrait__leader,
    .portrait__callout :global(.balloon) {
      display: none;
    }

    /* A long Dutch word ("gecertificeerd") hyphenates rather than leave a 90 px cell. */
    .portrait__callout-text {
      min-width: 0;
      max-width: none;
      hyphens: auto;
      overflow-wrap: anywhere;
    }
  }
</style>
