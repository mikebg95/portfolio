---
import { getLocalized } from '../../i18n/content';
import type { Lang } from '../../i18n/paths';
import DisplayHeading from '../drawing/DisplayHeading.astro';
import SheetLabel from '../drawing/SheetLabel.astro';

// SPEC §4.1 "How I work": the four numbered principles as a ruled drawing grid (4 columns, 2 on
// tablet), then the mono AI note; desktop not drawn, built from design/README.md. Phone
// (overview-default-light-390): a snap-scrolling card rail with a position indicator (src/rail.ts).
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { labels, howIWork, aiNote } = (await getLocalized('profile', 'profile', lang)).data;
---

<section class="sheet-panel how-i-work" aria-labelledby="how-i-work-label">
  <h2 class="how-i-work__label" id="how-i-work-label">
    <SheetLabel as="span" data-reveal="wipe">
      {labels.howIWork}
    </SheetLabel>
  </h2>
  <ol class="how-i-work__grid" data-reveal="cards" data-rail aria-labelledby="how-i-work-label">
    {howIWork.map((principle, i) => (
      <li class="how-i-work__cell">
        <span class="how-i-work__number" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <DisplayHeading as="h3" size="s">
          {principle.title}
        </DisplayHeading>
        <p class="how-i-work__body">{principle.body}</p>
      </li>
    ))}
  </ol>
  <div class="how-i-work__index" data-rail-index aria-hidden="true">
    {howIWork.map(() => (
      <span class="how-i-work__bar" />
    ))}
  </div>
  <p class="how-i-work__ai" data-reveal="rise">
    {aiNote}
  </p>
</section>

<script>
  import { rails } from '../../rail';
  import { onPage } from '../../router';

  onPage((signal) => rails(document, signal));
</script>

<style>
  .how-i-work {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .how-i-work__label {
    margin: 0;
    font: inherit;
  }

  /* Cells draw their left and top rules, the grid its right and bottom: ruled at any column count. */
  .how-i-work__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-right: var(--border-thin);
    border-bottom: var(--border-thin);
    list-style: none;
  }

  .how-i-work__cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    border-top: var(--border-thin);
    border-left: var(--border-thin);
  }

  .how-i-work__number {
    color: var(--color-line);
    font-family: var(--font-mono);
    font-size: var(--size-label);
    letter-spacing: var(--size-label-letter-spacing);
  }

  .how-i-work__body {
    margin: 0;
    color: var(--color-text-2);
    font-size: 15px;
    line-height: 1.6;
  }

  .how-i-work__ai {
    max-width: 880px;
    margin: 0;
    color: var(--color-text-2);
    font-family: var(--font-mono);
    font-size: var(--size-code);
    line-height: 1.7;
  }

  @media (max-width: 1023px) {
    .how-i-work__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .how-i-work__index {
    display: none;
  }

  /* Phone: the cards become a rail running out to the sheet's edge, one card and the next one's
     edge in view, snapping card by card. Without JS it is a plain overflow scroller. */
  @media (max-width: 767px) {
    .how-i-work__grid {
      --rail-inset: var(--sheet-content-padding-phone);

      display: flex;
      gap: 10px;
      margin-inline: calc(-1 * var(--rail-inset));
      padding: 0 var(--rail-inset) var(--space-1);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      border: none;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--rail-inset);
    }

    /* With JS the indicator shows the position; without it the scrollbar stays. */
    :global(.js) .how-i-work__grid {
      scrollbar-width: none;
    }

    .how-i-work__cell {
      flex: 0 0 min(284px, 84%);
      padding: var(--space-4);
      border: var(--border-normal);
      background: var(--color-paper-raised);
      scroll-snap-align: start;
    }

    .how-i-work__number {
      font-size: 20px;
      font-weight: 600;
      letter-spacing: 0;
    }

    .how-i-work__body {
      font-size: 13.5px;
      line-height: 1.5;
    }

    /* The position indicator, drawn by src/rail.ts — so only with JS. */
    :global(.js) .how-i-work__index {
      display: flex;
      gap: 6px;
    }

    .how-i-work__bar {
      width: 8px;
      height: 3px;
      background: var(--color-rule);
    }

    .how-i-work__bar[data-current] {
      width: 18px;
      background: var(--color-ink);
    }
  }
</style>
