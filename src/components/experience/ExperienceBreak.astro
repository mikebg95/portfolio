---
import type { CollectionEntry } from 'astro:content';

import { formatSpan, type DateWords } from '../../dates';

// The small hatched block between two detail blocks (copy.md Sheet 02 "Sabbatical"; not drawn):
// the detail block's two columns, a dashed hatched swatch — the timeline's sabbatical bar — in
// place of the number, and one line of context. Inside an employer's years (Conspect) it is one of
// its assignments: numbered (`02.1b`) and titled h3, under the employer's h2. Below 768 px it is
// a dashed, hatched card among ExperienceDetail's.
interface Props {
  entry: CollectionEntry<'experience'>['data'];
  /** `02.1b`, when the break is an assignment */
  number?: string;
  dates: DateWords;
}

const { entry, number, dates } = Astro.props;
const Title = entry.parent === undefined ? 'h2' : 'h3';
---

<article class="experience-break" id={entry.id}>
  <div class="experience-break__meta" data-reveal="ink">
    {number && <span class="experience-break__number">{number}</span>}
    <span class="experience-break__swatch" aria-hidden="true"></span>
    <span>{formatSpan(entry, dates, ' — ')}</span>
    <span class="experience-break__caps">{entry.place}</span>
  </div>
  <div class="experience-break__body">
    <Title class="experience-break__title" data-reveal="wipe">
      {entry.role}
    </Title>
    <p class="experience-break__context" data-reveal="ink">
      {entry.context}
    </p>
  </div>
</article>

<style>
  .experience-break {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-7);
    padding: var(--space-5) var(--sheet-content-padding);
  }

  .experience-break__meta {
    display: flex;
    flex: 0 1 220px;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .experience-break__number {
    color: var(--color-line);
    font-size: 20px;
    font-weight: 600;
  }

  .experience-break__swatch {
    width: 72px;
    height: 24px;
    border: 1.5px dashed var(--color-ink);
    background-image: repeating-linear-gradient(
      -45deg,
      color-mix(in srgb, var(--color-ink) 50%, transparent) 0 1px,
      transparent 1px 7px
    );
  }

  .experience-break__caps,
  .experience-break__title {
    text-transform: uppercase;
  }

  .experience-break__body {
    display: flex;
    flex: 999 1 520px;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .experience-break__title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--size-label);
    font-weight: 600;
    letter-spacing: var(--size-label-letter-spacing);
  }

  .experience-break__context {
    margin: 0;
    color: var(--color-text-2);
    font-size: 15px;
    line-height: 1.6;
  }

  /* Phone (experience-default-light-390): a dashed, hatched card among the others — the card is
     the swatch. */
  @media (max-width: 767px) {
    .experience-break {
      flex-direction: column;
      gap: 6px;
      padding: 14px 14px 12px;
      border: 1.5px dashed var(--color-ink);
      background-color: var(--color-paper-raised);
      background-image: repeating-linear-gradient(
        -45deg,
        color-mix(in srgb, var(--color-ink) 12%, transparent) 0 1px,
        transparent 1px 7px
      );
    }

    .experience-break__meta {
      flex: none;
      flex-flow: row wrap;
      gap: 0 0.6ch;
      font-size: 10.5px;
      letter-spacing: 0.08em;
      line-height: 1.6;
    }

    .experience-break__meta
      > :not(.experience-break__swatch)
      ~ :not(.experience-break__swatch)::before {
      content: '· ';
      content: '· ' / '';
    }

    .experience-break__number {
      color: inherit;
      font-size: inherit;
      font-weight: inherit;
    }

    .experience-break__swatch {
      display: none;
    }

    .experience-break__body {
      flex: none;
    }

    .experience-break__context {
      color: var(--color-ink);
      font-size: 14px;
      line-height: 1.5;
    }
  }

  /* WebKit draws no dashed sides at a fractional width on a 3× screen (1.5 px snaps to 1.33 px);
     a whole pixel there. 1× and 2× screens keep the drawn 1.5 px. */
  @media (min-resolution: 2.5dppx) {
    .experience-break,
    .experience-break__swatch {
      border-width: 1px;
    }
  }
</style>
