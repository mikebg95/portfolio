---
import type { CollectionEntry } from 'astro:content';

import { formatSpan, type DateWords } from '../../dates';
import DisplayHeading from '../drawing/DisplayHeading.astro';
import RevisionNote from '../drawing/RevisionNote.astro';

// components.md ExperienceDetail, drawn in experience-default-light-1440: a left column (number,
// dates, employer · place) and a right one (title, context, bullets, optional revision note, stack
// line). Its id is the entry's, the target of the timeline bar and the Overview's links.
// An employer (Conspect) titles itself `role — employer` and nests its assignments, passed as the
// slot, under a bracket; an assignment's h3 meta names its engagement instead of the employer.
// Below 768 px (experience-default-light-390) each block is a card — the employer's a dark header
// card, its bracket down the left of it and its assignments — and with JS the bullets and stack
// fold away behind a READ MORE toggle; the whole card is its tap target. Without JS all is shown.
interface Props {
  entry: CollectionEntry<'experience'>['data'];
  /** `02.1`, `02.1a` */
  number: string;
  dates: DateWords;
  /** The phone card's toggle words (`ui.experience.toggle`). */
  toggle: { more: string; less: string };
}

const { entry, number, dates, toggle } = Astro.props;
const assignment = entry.parent !== undefined;
const title =
  entry.kind === 'employer'
    ? `${entry.role} — ${entry.employer}`
    : `${entry.client ?? entry.employer} — ${entry.role}`;
const assignments = Astro.slots.has('default');
const folds = [
  entry.bullets.length > 0 && `${entry.id}-bullets`,
  entry.stack.length > 0 && `${entry.id}-stack`,
].filter((id) => id !== false);
---

<article
  class:list={[
    'experience-detail',
    { 'experience-detail--assignment': assignment, 'experience-detail--employer': assignments },
  ]}
  id={entry.id}
>
  <div class="experience-detail__meta" data-reveal="ink">
    <span class="experience-detail__number">{number}</span>
    <span>{formatSpan(entry, dates, ' — ')}</span>
    {assignment ? (
      <>
        {entry.engagement && (
          <span class="experience-detail__caps experience-detail__engagement">
            {entry.engagement}
          </span>
        )}
        <span class="experience-detail__caps">{entry.place}</span>
      </>
    ) : (
      <span class="experience-detail__caps">
        {entry.employer} · {entry.place}
      </span>
    )}
  </div>
  <div class="experience-detail__body">
    <DisplayHeading
      as={assignment ? 'h3' : 'h2'}
      size="m"
      class="experience-detail__title"
      data-reveal="wipe"
    >
      {title}
    </DisplayHeading>
    <p class="experience-detail__context" data-reveal="ink">
      {entry.context}
    </p>
    {entry.bullets.length > 0 && (
      <ul class="experience-detail__bullets experience-detail__fold" id={`${entry.id}-bullets`}>
        {entry.bullets.map((bullet, i) => (
          <li data-reveal="ink" data-reveal-delay={i * 80}>
            {bullet}
          </li>
        ))}
      </ul>
    )}
    {entry.note && <RevisionNote text={entry.note} data-reveal="stamp" />}
    {entry.stack.length > 0 && (
      <p
        class="experience-detail__stack experience-detail__fold"
        id={`${entry.id}-stack`}
        data-reveal="ink"
      >
        {entry.stack.map((item, i) => (
          <>
            {i > 0 && ' · '}
            <span>{item}</span>
          </>
        ))}
      </p>
    )}
    {folds.length > 0 && (
      <button
        type="button"
        class="experience-detail__toggle"
        aria-expanded="false"
        aria-controls={folds.join(' ')}
      >
        <span class="experience-detail__toggle-more">
          {toggle.more} <span aria-hidden="true">↓</span>
        </span>
        <span class="experience-detail__toggle-less">
          {toggle.less} <span aria-hidden="true">↑</span>
        </span>
        <span class="sr-only">· {title}</span>
      </button>
    )}
  </div>
  {assignments && (
    <div class="experience-detail__assignments">
      <span class="experience-detail__bracket" aria-hidden="true">
        <span class="experience-detail__bracket-label">
          {entry.employer}
          <span class="experience-detail__bracket-dates">{` · ${formatSpan(entry, dates)}`}</span>
        </span>
      </span>
      <slot />
    </div>
  )}
</article>

<style>
  .experience-detail {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-7);
    padding: var(--space-7) var(--sheet-content-padding);
  }

  .experience-detail__meta {
    display: flex;
    flex: 0 1 220px;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .experience-detail__number {
    color: var(--color-line);
    font-size: 34px;
    font-weight: 600;
  }

  .experience-detail__caps {
    text-transform: uppercase;
  }

  .experience-detail__body {
    display: flex;
    flex: 999 1 520px;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  .experience-detail .experience-detail__title {
    font-size: clamp(24px, 3vw, 30px);
    font-weight: 800;
    font-stretch: 112%;
  }

  .experience-detail__context {
    margin: 0;
    color: var(--color-text-2);
    font-size: var(--size-body);
    line-height: var(--size-body-line-height);
  }

  .experience-detail__bullets {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding-left: 20px;
    font-size: 15px;
    line-height: 1.6;
  }

  .experience-detail__stack {
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.8;
  }

  /* Wrap between items, never inside one ("Spring Security"). */
  .experience-detail__stack span {
    white-space: nowrap;
  }

  .experience-detail--assignment .experience-detail__title {
    font-size: clamp(20px, 2.4vw, 26px);
  }

  /* The employer's engagement (client assignment, internal product) reads in line colour. */
  .experience-detail__engagement {
    color: var(--color-line);
  }

  /* Assignments nest under the employer's block: a bracket in line colour down their left side,
     ticks at both ends (the timeline's dimension line, turned), its name along it. */
  .experience-detail__assignments {
    position: relative;
    flex: 1 1 100%;
    padding-left: var(--space-7);
  }

  .experience-detail__bracket {
    position: absolute;
    inset: 0 auto 0 0;
    width: 12px;
    border: solid var(--color-line);
    border-width: 1px 0 1px 1px;
  }

  .experience-detail__bracket-label {
    position: absolute;
    top: var(--space-7);
    left: 6px;
    padding: 4px 0;
    background: var(--color-paper);
    color: var(--color-line);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    writing-mode: vertical-rl;
    transform: translateX(-50%) rotate(180deg);
  }

  .experience-detail__assignments > :global(article) {
    padding-right: 0;
    padding-left: 0;
  }

  .experience-detail__assignments > :global(article + article) {
    border-top: 1px dashed var(--color-rule);
  }

  .experience-detail__assignments > :global(article:last-child) {
    padding-bottom: 0;
  }

  .experience-detail__toggle,
  .experience-detail__bracket-dates {
    display: none;
  }

  /* Phone (experience-default-light-390): cards beside the page's ruler. */
  @media (max-width: 767px) {
    .experience-detail {
      position: relative;
      flex-direction: column;
      gap: 6px;
      padding: 14px 14px 12px;
      border: 1.5px solid var(--color-ink);
      background: var(--color-paper-raised);
    }

    /* One mono line, wrapping between its parts: 02.1a · JUN 2026 — NOW · ENGAGEMENT · PLACE. */
    .experience-detail__meta {
      flex: none;
      flex-flow: row wrap;
      gap: 0 0.6ch;
      color: var(--color-line);
      font-size: 10.5px;
      letter-spacing: 0.08em;
      line-height: 1.6;
    }

    .experience-detail__meta > * + *::before {
      content: '· ';
      content: '· ' / '';
    }

    .experience-detail__number {
      font-size: inherit;
    }

    .experience-detail__body {
      flex: none;
      gap: 8px;
    }

    .experience-detail .experience-detail__title,
    .experience-detail--assignment .experience-detail__title {
      font-size: 18px;
    }

    .experience-detail__context {
      font-size: 14px;
      line-height: 1.5;
    }

    .experience-detail__bullets {
      padding-left: 16px;
      font-size: 14px;
      line-height: 1.5;
    }

    .experience-detail__body :global(.revision-note) {
      padding: 8px 10px;
      font-size: 11.5px;
      line-height: 1.5;
    }

    /* The employer is a dark header card; its assignments follow as cards of their own, the
       bracket down their left in the column between the ruler and the cards. */
    .experience-detail--employer {
      gap: 0;
      padding: 0;
      border: 0;
      background: none;
    }

    .experience-detail--employer > .experience-detail__meta,
    .experience-detail--employer > .experience-detail__body {
      background: var(--color-ink);
      color: var(--color-ink-on-fill);
    }

    .experience-detail--employer > .experience-detail__meta {
      padding: 14px 14px 6px;
    }

    .experience-detail--employer > .experience-detail__body {
      padding: 0 14px 14px;
    }

    .experience-detail--employer > .experience-detail__meta > .experience-detail__number {
      color: inherit;
    }

    .experience-detail--employer > .experience-detail__body > .experience-detail__title {
      font-size: 20px;
    }

    .experience-detail--employer > .experience-detail__body > .experience-detail__context {
      color: color-mix(in srgb, var(--color-ink-on-fill) 80%, transparent);
    }

    .experience-detail__assignments {
      position: static;
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-top: 10px;
      padding-left: 0;
    }

    .experience-detail__assignments > :global(article),
    .experience-detail__assignments > :global(article:last-child) {
      padding: 14px 14px 12px;
    }

    .experience-detail__assignments > :global(article + article) {
      border-top: 1.5px solid var(--color-ink);
    }

    .experience-detail__assignments > :global(article + article.experience-break) {
      border-top-style: dashed;
    }

    .experience-detail__bracket {
      left: calc(var(--experience-ruler, 40px) + 4px - var(--experience-cards, 70px));
      width: 18px;
      border-width: 1.5px 1.5px 1.5px 0;
    }

    .experience-detail__bracket-label {
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-size: 9.5px;
      letter-spacing: 0.14em;
    }

    .experience-detail__bracket-dates {
      display: inline;
    }

    /* With JS the bullets and stack fold away behind the toggle; its ::after spans the card, so
       a tap anywhere on it opens or closes the card in place. */
    :global(.js) .experience-detail__toggle {
      display: flex;
      align-items: center;
      align-self: flex-start;
      min-height: 44px;
      margin: -6px 0 -10px;
      padding: 0;
      border: 0;
      background: none;
      color: var(--color-line);
      font-family: var(--font-mono);
      font-size: 10.5px;
      letter-spacing: 0.08em;
      cursor: pointer;
    }

    .experience-detail__toggle::after {
      content: '';
      position: absolute;
      inset: 0;
    }

    .experience-detail__toggle[aria-expanded='true'] .experience-detail__toggle-more,
    .experience-detail__toggle[aria-expanded='false'] .experience-detail__toggle-less {
      display: none;
    }

    :global(.js)
      .experience-detail:not(.experience-detail--open)
      > .experience-detail__body
      > .experience-detail__fold {
      display: none;
    }
  }
</style>

<script>
  // The phone cards' READ MORE: opens or closes its card in place; a link to a card (the
  // Overview's `#optiecon`) arrives with it open.
  const OPEN = 'experience-detail--open';

  const setOpen = (button: HTMLButtonElement, open: boolean) => {
    button.setAttribute('aria-expanded', String(open));
    button.closest('.experience-detail')?.classList.toggle(OPEN, open);
  };

  const toggles = document.querySelectorAll<HTMLButtonElement>('.experience-detail__toggle');
  for (const button of toggles) {
    button.addEventListener('click', () =>
      setOpen(button, button.getAttribute('aria-expanded') !== 'true'),
    );
  }

  const openTarget = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    const target = id ? document.getElementById(id) : null;
    const button = target?.querySelector<HTMLButtonElement>(
      ':scope > .experience-detail__body > .experience-detail__toggle',
    );
    if (button) setOpen(button, true);
  };
  openTarget();
  window.addEventListener('hashchange', openTarget);
</script>
