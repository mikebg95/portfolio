---
import type { CollectionEntry } from 'astro:content';

import { formatSpan, type DateWords } from '../../dates';
import DisplayHeading from '../drawing/DisplayHeading.astro';
import RevisionNote from '../drawing/RevisionNote.astro';

// components.md ExperienceDetail, drawn in experience-default-light-1440: a left column (number,
// dates, employer · place) and a right one (title, context, bullets, optional revision note, stack
// line). Its id is the entry's, the target of the timeline bar and the Overview's links.
// An employer (Conspect) titles itself `role — employer` and nests its assignments, passed as the
// slot, under a bracket; an assignment's h3 meta names its engagement instead of the employer.
interface Props {
  entry: CollectionEntry<'experience'>['data'];
  /** `02.1`, `02.1a` */
  number: string;
  dates: DateWords;
}

const { entry, number, dates } = Astro.props;
const assignment = entry.parent !== undefined;
const title =
  entry.kind === 'employer'
    ? `${entry.role} — ${entry.employer}`
    : `${entry.client ?? entry.employer} — ${entry.role}`;
const assignments = Astro.slots.has('default');
---

<article
  class:list={['experience-detail', { 'experience-detail--assignment': assignment }]}
  id={entry.id}
>
  <div class="experience-detail__meta" data-reveal="ink">
    <span class="experience-detail__number">{number}</span>
    <span>{formatSpan(entry, dates, ' — ')}</span>
    {assignment ? (
      <>
        {entry.engagement && (
          <span class="experience-detail__caps experience-detail__engagement">
            {entry.engagement}
          </span>
        )}
        <span class="experience-detail__caps">{entry.place}</span>
      </>
    ) : (
      <span class="experience-detail__caps">
        {entry.employer} · {entry.place}
      </span>
    )}
  </div>
  <div class="experience-detail__body">
    <DisplayHeading
      as={assignment ? 'h3' : 'h2'}
      size="m"
      class="experience-detail__title"
      data-reveal="wipe"
    >
      {title}
    </DisplayHeading>
    <p class="experience-detail__context" data-reveal="ink">
      {entry.context}
    </p>
    {entry.bullets.length > 0 && (
      <ul class="experience-detail__bullets">
        {entry.bullets.map((bullet, i) => (
          <li data-reveal="ink" data-reveal-delay={i * 80}>
            {bullet}
          </li>
        ))}
      </ul>
    )}
    {entry.note && <RevisionNote text={entry.note} data-reveal="stamp" />}
    {entry.stack.length > 0 && (
      <p class="experience-detail__stack" data-reveal="ink">
        {entry.stack.map((item, i) => (
          <>
            {i > 0 && ' · '}
            <span>{item}</span>
          </>
        ))}
      </p>
    )}
  </div>
  {assignments && (
    <div class="experience-detail__assignments">
      <span class="experience-detail__bracket" aria-hidden="true">
        <span class="experience-detail__bracket-label">{entry.employer}</span>
      </span>
      <slot />
    </div>
  )}
</article>

<style>
  .experience-detail {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-7);
    padding: var(--space-7) var(--sheet-content-padding);
  }

  .experience-detail__meta {
    display: flex;
    flex: 0 1 220px;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .experience-detail__number {
    color: var(--color-line);
    font-size: 34px;
    font-weight: 600;
  }

  .experience-detail__caps {
    text-transform: uppercase;
  }

  .experience-detail__body {
    display: flex;
    flex: 999 1 520px;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  .experience-detail .experience-detail__title {
    font-size: clamp(24px, 3vw, 30px);
    font-weight: 800;
    font-stretch: 112%;
  }

  .experience-detail__context {
    margin: 0;
    color: var(--color-text-2);
    font-size: var(--size-body);
    line-height: var(--size-body-line-height);
  }

  .experience-detail__bullets {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding-left: 20px;
    font-size: 15px;
    line-height: 1.6;
  }

  .experience-detail__stack {
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.8;
  }

  /* Wrap between items, never inside one ("Spring Security"). */
  .experience-detail__stack span {
    white-space: nowrap;
  }

  .experience-detail--assignment .experience-detail__title {
    font-size: clamp(20px, 2.4vw, 26px);
  }

  /* The employer's engagement (client assignment, internal product) reads in line colour. */
  .experience-detail__engagement {
    color: var(--color-line);
  }

  /* Assignments nest under the employer's block: a bracket in line colour down their left side,
     ticks at both ends (the timeline's dimension line, turned), its name along it. */
  .experience-detail__assignments {
    position: relative;
    flex: 1 1 100%;
    padding-left: var(--space-7);
  }

  .experience-detail__bracket {
    position: absolute;
    inset: 0 auto 0 0;
    width: 12px;
    border: solid var(--color-line);
    border-width: 1px 0 1px 1px;
  }

  .experience-detail__bracket-label {
    position: absolute;
    top: var(--space-7);
    left: 6px;
    padding: 4px 0;
    background: var(--color-paper);
    color: var(--color-line);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    writing-mode: vertical-rl;
    transform: translateX(-50%) rotate(180deg);
  }

  .experience-detail__assignments > :global(article) {
    padding-right: 0;
    padding-left: 0;
  }

  .experience-detail__assignments > :global(article + article) {
    border-top: 1px dashed var(--color-rule);
  }

  .experience-detail__assignments > :global(article:last-child) {
    padding-bottom: 0;
  }

  @media (max-width: 767px) {
    .experience-detail__assignments {
      padding-left: var(--space-5);
    }

    .experience-detail {
      gap: var(--space-4);
      padding: var(--space-6) var(--sheet-content-padding-phone);
    }

    .experience-detail__number {
      font-size: 28px;
    }
  }
</style>
