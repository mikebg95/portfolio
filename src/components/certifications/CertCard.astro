---
import type { CollectionEntry } from 'astro:content';

import { formatMonth, type DateWords } from '../../dates';
import Chip from '../drawing/Chip.astro';
import ChipList from '../drawing/ChipList.astro';
import DisplayHeading from '../drawing/DisplayHeading.astro';
import Link from '../drawing/Link.astro';
import SheetLabel from '../drawing/SheetLabel.astro';
import Stamp from '../drawing/Stamp.astro';

// components.md CertCard: 1.5 px ink border, padding 28, the stamp in the top-right corner; code,
// name, issuer · date, what I learned, skill chips, then the verify link to the issuer's own
// record. Pending is dashed redline with no link. The block's id is the entry id (`#ckad`).
// Motion (§M6): the stamps slam down in card order, 120 ms apart, once the cards have begun to rise.
interface Props {
  id: string;
  /** The card's place on the sheet, for the stamp sequence. */
  index: number;
  cert: CollectionEntry<'certifications'>['data'];
  dates: DateWords;
  /** Shown in place of the date while pending (`ui.certifications.pending`). */
  pending: string;
}

const { id, index, cert, dates, pending } = Astro.props;
const STAMP_START_MS = 300;
const STAMP_STAGGER_MS = 120;
const isPending = cert.status === 'pending';
const nameId = `${id}-name`;
---

<article class:list={['cert-card', isPending && 'cert-card--pending']} id={id} data-cert={id}>
  <div class="cert-card__head">
    <Stamp
      lines={cert.stamp}
      state={cert.status}
      class="cert-card__stamp"
      data-reveal="stamp"
      data-reveal-delay={String(STAMP_START_MS + index * STAMP_STAGGER_MS)}
    />
    <SheetLabel as="span" class="cert-card__code">
      {cert.code}
    </SheetLabel>
    <DisplayHeading as="h2" size="s" id={nameId} fitTo="container">
      {cert.name}
    </DisplayHeading>
    <p class="cert-card__issuer">
      {cert.issuer} · {cert.date === null ? pending : formatMonth(cert.date, dates)}
    </p>
  </div>
  <p class="cert-card__learned">{cert.learned}</p>
  <ChipList>
    {cert.skills.map((skill) => (
      <Chip>{skill}</Chip>
    ))}
  </ChipList>
  {cert.verifyUrl && (
    <Link href={cert.verifyUrl} external class="cert-card__verify" aria-describedby={nameId}>
      {cert.verifyLabel}
    </Link>
  )}
</article>

<style>
  .cert-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px;
    border: var(--border-normal);
    background: var(--color-paper-raised);
  }

  .cert-card--pending {
    border-style: dashed;
    border-color: var(--color-redline);
  }

  .cert-card--pending :global(.cert-card__code) {
    color: var(--color-redline);
  }

  /* The stamp floats in the corner, 22 px in from the edges (the card pads 28), and the code, name
     and issuer wrap around its circle, so a long name uses the full width below it. The name's
     size is capped by the card's width, so no word of it breaks mid-word in a phone column. */
  .cert-card__head {
    container-type: inline-size;
    display: flow-root;
  }

  .cert-card__head > :global(*:not(.cert-card__stamp)) {
    display: block;
  }

  .cert-card__head > :global(* + *:not(.cert-card__stamp)) {
    margin-top: 14px;
  }

  .cert-card__head > :global(.cert-card__stamp + *) {
    margin-top: 0;
  }

  .cert-card__head :global(.cert-card__stamp) {
    float: right;
    margin: -6px -6px 8px 12px;
    shape-outside: circle(50%);
    shape-margin: 8px;
  }

  /* A word too long to sit beside the stamp drops below it instead of breaking (the size cap and
     DisplayHeading's fit, against this head's width, keep every word inside the card). */
  .cert-card__head :global(h2) {
    font-size: min(var(--size-display-s), 10cqi);
  }

  .cert-card__issuer {
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--size-code);
  }

  .cert-card__learned {
    margin: 0;
    color: var(--color-text-2);
    font-size: 15px;
    line-height: 1.6;
  }

  .cert-card :global(.cert-card__verify) {
    align-self: flex-start;
    padding-top: 6px;
    font-family: var(--font-mono);
    font-size: 12.5px;
  }

  /* Phone: the card language of the phone drawings (PR-62e). A title-block strip across the top —
     code, then issuer · date — the name the card's full width (no float to wrap round), and a ruled
     foot where the stamp signs the record beside its verify link. The head's parts join the card's
     grid; the name is its own fit container again, as nothing floats beside it here. */
  @media (max-width: 767px) {
    .cert-card {
      container-type: inline-size;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 0;
      padding: 0;
    }

    .cert-card__head {
      display: contents;
    }

    .cert-card__head > :global(*:not(.cert-card__stamp)),
    .cert-card__head > :global(* + *:not(.cert-card__stamp)) {
      margin-top: 0;
    }

    .cert-card__head :global(.cert-card__code),
    .cert-card__issuer {
      grid-row: 1;
      padding: 9px 16px;
      border-bottom: var(--border-thin);
      line-height: 1.4;
    }

    .cert-card__head :global(.cert-card__code) {
      grid-column: 1;
      border-right: var(--border-thin);
    }

    .cert-card__issuer {
      grid-column: 2 / -1;
      font-size: 11px;
      text-align: end;
    }

    .cert-card--pending :global(.cert-card__code),
    .cert-card--pending .cert-card__issuer {
      border-bottom: 1px dashed var(--color-redline);
    }

    .cert-card--pending :global(.cert-card__code) {
      border-right: 1px dashed var(--color-redline);
    }

    .cert-card__head :global(h2) {
      grid-row: 2;
      grid-column: 1 / -1;
      container-type: inline-size;
      padding: 20px 20px 0;
      font-size: min(var(--size-display-s), 10cqi);
    }

    .cert-card__learned,
    .cert-card > :global(.chip-list) {
      grid-column: 1 / -1;
      padding: 14px 20px 0;
    }

    .cert-card__learned {
      grid-row: 3;
    }

    .cert-card > :global(.chip-list) {
      grid-row: 4;
      padding-bottom: 20px;
    }

    /* The foot's rule spans the card, with or without a verify link beside the stamp. */
    .cert-card::after {
      content: '';
      grid-row: 5;
      grid-column: 1 / -1;
      border-top: var(--border-thin);
      pointer-events: none;
    }

    .cert-card--pending::after {
      border-top: 1px dashed var(--color-redline);
    }

    .cert-card :global(.cert-card__verify) {
      grid-row: 5;
      grid-column: 1 / 3;
      align-self: center;
      justify-self: start;
      margin-left: 20px;
      padding-block: 12px;
      line-height: 20px;
      text-wrap: balance;
    }

    .cert-card__head :global(.cert-card__stamp) {
      grid-row: 5;
      grid-column: 3;
      float: none;
      margin: 12px 16px 14px 8px;
      shape-outside: none;
    }
  }

  /* WebKit draws no dashed sides at a fractional width on a 3× screen (1.5 px snaps to 1.33 px);
     a whole pixel there. 1× and 2× screens keep the drawn 1.5 px. */
  @media (min-resolution: 2.5dppx) {
    .cert-card--pending {
      border-width: 1px;
    }
  }
</style>
