---
import Arrow from '../drawing/Arrow.astro';
import Box from '../drawing/Box.astro';
import Link from '../drawing/Link.astro';
import PipelineRoute from '../drawing/PipelineRoute.astro';

// The drawing inside a detail sheet's FIG. 1 or FIG. 2 (SPEC §4.4), one layout per project and
// figure. Words come from the entry's `figures[n - 1].labels`, in drawing order; LABELS says how
// many each layout reads. A box label's first line is its title; a test pyramid level's is its name,
// the second its test count; a decision record's is its title, the second its URL. A project without
// a layout here draws nothing yet (PR-29 adds its own).
interface Props {
  slug: string;
  n: 1 | 2;
  labels: string[];
}

const LABELS: Record<string, readonly [number, number]> = {
  jamigos: [6, 4],
  'subscription-tracker': [7, 4],
  'recipe-book': [9, 4],
  journal: [8, 7],
};

// Figures that are one row of boxes joined by labelled arrows (box, arrow, box, …): the index of
// the `main` box, the one the project is about. Each arrow stays with the box it points at, so a
// row that wraps starts its next line with an arrow.
const CHAINS: Record<string, number> = {
  'subscription-tracker-1': 4,
  'recipe-book-1': 0,
};

const { slug, n, labels } = Astro.props;
const expected = LABELS[slug]?.[n - 1];
if (expected === undefined && labels.length > 0) {
  throw new Error(`no FIG. ${n} layout for project ${slug}, but it has labels`);
}
if (expected !== undefined && labels.length !== expected) {
  throw new Error(`FIG. ${n} of ${slug} draws ${expected} labels, got ${labels.length}`);
}
// A box label: the first line is the title, the rest the body, one line each.
const box = (label = '') => {
  const [title = '', ...lines] = label.split('\n');
  return { title, lines };
};
const [a = '', b = '', c = '', d = '', e = '', f = '', g = '', h = ''] = labels;
const api = box(c);
const layout = `${slug}-${n}`;
---

{layout === 'jamigos-1' && (
  <div class="detail-figure">
    <div class="detail-figure__row">
      <Box title={box(a).title}>{box(a).lines[0]}</Box>
      <Arrow label={b} turns />
      <Box title={api.title} main>
        {api.lines.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </Box>
      <Arrow turns />
      <div class="detail-figure__stack">
        <Box title={box(d).title}>{box(d).lines[0]}</Box>
        <Box title={box(e).title}>{box(e).lines[0]}</Box>
      </div>
    </div>
    <Box title={box(f).title} external>
      {box(f).lines[0]}
    </Box>
  </div>
)}
{layout === 'jamigos-2' && <PipelineRoute stations={labels} />}
{CHAINS[layout] !== undefined && (
  <div class="detail-figure">
    <div class="detail-figure__row">
      <Box title={box(a).title} main={CHAINS[layout] === 0}>
        {box(a).lines[0]}
      </Box>
      {labels.slice(1).map((label, i) =>
        i % 2 === 0 ? (
          <span class="detail-figure__link">
            <Arrow label={label} turns />
            <Box title={box(labels[i + 2]).title} main={i + 2 === CHAINS[layout]}>
              {box(labels[i + 2]).lines[0]}
            </Box>
          </span>
        ) : null,
      )}
    </div>
  </div>
)}
{layout === 'subscription-tracker-2' && (
  <ol class="test-pyramid">
    {labels.map((label, i) => (
      <li class="test-pyramid__level" style={`--level: ${i}`}>
        <strong class="test-pyramid__count">{box(label).lines[0]}</strong>
        {box(label).title}
      </li>
    ))}
  </ol>
)}
{layout === 'recipe-book-2' && (
  <div class="detail-figure detail-figure--tight">
    <Box title={box(a).title} main>
      {box(a).lines[0]}
    </Box>
    <Arrow direction="down" label={b} />
    <div class="detail-figure__parts">
      <Box title={box(c).title}>{box(c).lines[0]}</Box>
      <Box title={box(d).title}>{box(d).lines[0]}</Box>
    </div>
  </div>
)}
{layout === 'journal-1' && (
  <div class="detail-figure">
    <div class="detail-figure__row">
      <Box title={box(c).title}>{box(c).lines[0]}</Box>
      <Arrow label={d} turns />
      <div class="hexagon">
        <strong class="hexagon__title">{box(b).title}</strong>
        {box(b).lines[0]}
        <Box title={box(a).title} main>
          {box(a).lines[0]}
        </Box>
      </div>
      <div class="detail-figure__stack detail-figure__stack--fan">
        {[
          [f, e],
          [h, g],
        ].map(([port, adapter]) => (
          <span class="detail-figure__link">
            <Arrow label={port} turns />
            <Box title={box(adapter).title}>{box(adapter).lines[0]}</Box>
          </span>
        ))}
      </div>
    </div>
  </div>
)}
{layout === 'journal-2' && (
  <ol class="adr-list">
    {labels.map((label, i) => (
      <li>
        <Link href={box(label).lines[0] ?? ''} external>
          <span class="adr-list__n">ADR-{String(i + 1).padStart(4, '0')}</span>
          {box(label).title}
        </Link>
      </li>
    ))}
  </ol>
)}

<style>
  .detail-figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
  }

  .detail-figure__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 18px;
  }

  .detail-figure--tight {
    gap: 10px;
  }

  .detail-figure__link {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  /* An aggregate's parts sit side by side at every width: stacked, they would read as a chain. */
  .detail-figure__parts {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
  }

  .detail-figure__parts > :global(*) {
    flex: 0 1 180px;
  }

  .detail-figure__stack {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Top to bottom, each level wider than the one above: the pyramid's shape, not its counts. */
  .test-pyramid {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .test-pyramid__level {
    width: calc(55% + 15% * var(--level));
    padding: 8px 12px;
    border: var(--border-box);
    background: var(--color-paper);
    color: var(--color-line);
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.45;
    text-align: center;
    text-wrap: balance;
  }

  .test-pyramid__count {
    margin-right: var(--space-2);
    color: var(--color-ink);
    font-weight: 600;
  }

  /* Ports & adapters: the application as a hexagon (clip-path; the 2 px line is the outer hexagon
     showing round an inset paper one), the domain box at its centre. */
  .hexagon {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: 300px;
    aspect-ratio: 1.15;
    padding: 0 48px;
    color: var(--color-line);
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.45;
    text-align: center;
    clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%);
    background: var(--color-line);
    isolation: isolate;
  }

  .hexagon::before {
    content: '';
    position: absolute;
    inset: 2px 2.5px;
    z-index: -1;
    background: var(--color-paper);
    clip-path: inherit;
  }

  .hexagon__title {
    color: var(--color-ink);
    font-weight: 600;
  }

  .adr-list {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.45;
  }

  .adr-list li {
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-rule);
  }

  .adr-list__n {
    margin-right: var(--space-2);
    color: var(--color-ink);
    font-weight: 600;
  }

  /* Phone: the row becomes a column; its arrows turn down (Arrow `turns`). */
  @media (max-width: 767px) {
    .detail-figure__row,
    .detail-figure__link {
      flex-direction: column;
      gap: var(--space-3);
    }

    .hexagon {
      width: min(100%, 280px);
    }

    /* Both outbound adapters hang off the hexagon side by side: one under the other, they would
       read as persistence → AI. */
    .detail-figure__stack--fan {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-3);
      width: 100%;
    }

    .detail-figure__stack--fan > .detail-figure__link {
      flex: 1 1 0;
      min-width: 0;
    }
  }
</style>
