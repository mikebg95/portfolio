---
import type { CollectionEntry } from 'astro:content';

import DisplayHeading from '../drawing/DisplayHeading.astro';
import SheetLabel from '../drawing/SheetLabel.astro';
import MiniDiagram from './MiniDiagram.astro';
import { projectMorph } from '../../view-transitions';

// components.md ProjectCard: one register card, the whole card one link to its detail sheet.
// Label (P-0n · KIND, the in-progress one in redline), mini diagram, title, summary, then a
// title-block strip of the three facts. The flagship spans two grid columns from tablet up; the
// in-progress card is dashed. Hover/focus lifts it with the hard ink shadow and redraws the mini
// diagram's arrows (motion.md §M6).
interface Props {
  project: CollectionEntry<'projects'>['data'];
  href: string;
  headingLevel?: 'h2' | 'h3';
}

const { project, href, headingLevel = 'h2' } = Astro.props;
// The register's first card (copy.md `P-01`) is drawn large.
const flagship = project.order === 1;
const inProgress = project.status === 'in-progress';
---

<a
  class:list={[
    'project-card',
    flagship && 'project-card--flagship',
    inProgress && 'project-card--in-progress',
  ]}
  href={href}
  data-project={project.slug}
>
  <div class="project-card__head">
    <SheetLabel as="span" class="project-card__label">
      {project.code} · {project.kind}
    </SheetLabel>
    {project.tag && <span class="project-card__tag">{project.tag}</span>}
  </div>
  <div class="project-card__diagram" style={projectMorph(project.slug, 'figure')}>
    <MiniDiagram slug={project.slug} labels={project.diagram} />
  </div>
  <div class="project-card__body">
    <DisplayHeading
      as={headingLevel}
      size={flagship ? 'm' : 's'}
      class="project-card__title"
      style={projectMorph(project.slug, 'title')}
    >
      {project.title}
    </DisplayHeading>
    <p class="project-card__summary">{project.cardSummary}</p>
  </div>
  <dl class="project-card__strip">
    {project.facts.map((fact) => (
      <div>
        <dt>{fact.label}</dt>
        <dd data-count={fact.value === String(project.tests) || undefined}>{fact.value}</dd>
      </div>
    ))}
  </dl>
</a>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: var(--border-normal);
    background: var(--color-paper-raised);
    color: var(--color-ink);
    text-decoration: none;
  }

  /* The lift: --shadow-lift (6 px 6 px ink) as an ink box 6 px down-right of the card, clipped to
     the part outside the card, so the dashed border keeps its gaps. Lifting grows the clip from
     nothing at the card's corner to the full L (150 ms): clip-path animates, box-shadow would not
     be cheap (motion.md principle 2). */
  .project-card::after {
    content: '';
    position: absolute;
    inset: -1.5px;
    background: var(--color-ink);
    transform: translate(6px, 6px);
    clip-path: polygon(
      calc(100% - 6px) -6px,
      calc(100% - 6px) -6px,
      calc(100% - 6px) calc(100% - 6px),
      -6px calc(100% - 6px),
      -6px calc(100% - 6px),
      calc(100% - 6px) calc(100% - 6px)
    );
    pointer-events: none;
    transition: clip-path var(--motion-fast) var(--motion-ease-out);
  }

  .project-card:is(:hover, :focus-visible)::after {
    clip-path: polygon(
      calc(100% - 6px) 0,
      100% 0,
      100% 100%,
      0 100%,
      0 calc(100% - 6px),
      calc(100% - 6px) calc(100% - 6px)
    );
  }

  @media (prefers-reduced-motion: no-preference) {
    .project-card:is(:hover, :focus-visible) :global(.arrow) {
      animation: reveal-wipe 300ms var(--motion-ease-plot) backwards;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card::after {
      transition: none;
    }
  }

  @media (min-width: 768px) {
    .project-card--flagship {
      grid-column: span 2;
    }
  }

  .project-card--in-progress {
    border-style: dashed;
  }

  .project-card--in-progress :global(.project-card__label) {
    color: var(--color-redline);
  }

  .project-card__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 20px 22px 0;
  }

  .project-card__tag {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .project-card__diagram {
    padding: 22px;
  }

  .project-card--flagship .project-card__diagram {
    padding-block: 28px;
  }

  /* The display size, capped by the card's width so a long title (SUBSCRIPTION) never breaks
     mid-word in a narrow column. */
  .project-card__body {
    container-type: inline-size;
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-2);
    padding: 0 22px 20px;
  }

  .project-card__body :global(.project-card__title) {
    font-size: min(var(--size-display-s), 10cqi);
  }

  .project-card--flagship .project-card__body :global(.project-card__title) {
    font-size: var(--size-display-m);
  }

  .project-card__summary {
    margin: 0;
    color: var(--color-text-2);
    font-size: var(--size-small);
    line-height: 1.6;
  }

  .project-card--flagship .project-card__summary {
    font-size: 15px;
  }

  .project-card__strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    border-top: var(--border-normal);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.35;
  }

  .project-card__strip > div {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-2) 10px;
    border-left: var(--border-thin);
  }

  .project-card__strip > div:first-child {
    border-left: none;
  }

  .project-card__strip dt {
    color: var(--color-muted);
    font-size: 9px;
    letter-spacing: var(--size-micro-letter-spacing);
  }

  .project-card__strip dd {
    margin: 0;
  }

  /* Phone: the label line becomes the card's title strip, ruled off above the drawing as the phone
     drawings' cards are (PR-62e); the facts strip already closes the card below. */
  @media (max-width: 767px) {
    .project-card__head {
      align-items: baseline;
      padding: 10px 16px;
      border-bottom: var(--border-thin);
    }

    /* WebKit draws no dashed sides at 1.5 px on a 3× screen (it snaps to 1.33 px): a whole pixel. */
    .project-card--in-progress {
      border-width: 1px;
    }

    .project-card--in-progress .project-card__head {
      border-bottom-style: dashed;
    }

    .project-card__diagram,
    .project-card--flagship .project-card__diagram {
      padding: 22px 18px;
    }

    .project-card__body {
      padding: 0 18px 20px;
    }
  }
</style>
