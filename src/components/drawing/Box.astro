---
import type { HTMLAttributes } from 'astro/types';

// components.md Box: a system in a figure or mini diagram — 1.5 px line border, mono, the title on
// its own line in ink, details in the slot. `external` (dashed) is a system outside the project.
// `mini` is the register card's smaller box (10.5 px, a `\n` in the slot breaks the line); `main`
// is the system a diagram centres on (2.5 px border; more air in a figure, 600 weight when mini).
type Props = HTMLAttributes<'div'> & {
  title?: string;
  external?: boolean;
  mini?: boolean;
  main?: boolean;
};

const {
  title,
  external = false,
  mini = false,
  main = false,
  class: className,
  ...rest
} = Astro.props;
---

<div
  class:list={[
    'box',
    external && 'box--external',
    mini && 'box--mini',
    main && 'box--main',
    className,
  ]}
  {...rest}
>
  {title && <strong class="box__title">{title}</strong>}
  <slot />
</div>

<style>
  .box {
    padding: 10px 12px;
    border: var(--border-box);
    background: var(--color-paper);
    color: var(--color-line);
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.45;
    text-align: center;
  }

  .box--external {
    border-style: dashed;
  }

  .box--mini {
    padding: 6px 8px;
    font-size: 10.5px;
    line-height: 1.3;
    white-space: pre-line;
  }

  .box--main {
    padding: 16px 20px;
    border-width: 2.5px;
  }

  .box--mini.box--main {
    padding: 10px 14px;
    font-weight: 600;
  }

  .box__title {
    display: block;
    color: var(--color-ink);
    font-weight: 600;
  }
</style>
