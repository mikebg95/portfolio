---
import type { HTMLAttributes } from 'astro/types';

// components.md CertCard skill chips: 1 px muted border, mono 11.5 px, square. A run of chips is a
// list; wrap them in ChipList.
type Props = HTMLAttributes<'li'>;

const { class: className, ...rest } = Astro.props;
---

<li class:list={['chip', className]} {...rest}>
  <slot />
</li>

<style>
  .chip {
    padding: 4px 8px;
    border: 1px solid var(--color-muted);
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.4;
  }
</style>
