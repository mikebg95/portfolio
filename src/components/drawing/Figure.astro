---
import type { HTMLAttributes } from 'astro/types';

// components.md Figure: a 1.5 px ink frame on raised paper, captioned "FIG. n — NAME" above the
// drawing (Boxes and Arrows, or anything else, in the slot). `bare` drops the frame and padding for a
// figure that sits in its own panel (a detail sheet's FIG. 2).
type Props = HTMLAttributes<'figure'> & {
  label: string;
  bare?: boolean;
};

const { label, bare = false, class: className, ...rest } = Astro.props;
---

<figure class:list={['figure', bare && 'figure--bare', className]} {...rest}>
  <figcaption class="figure__label">{label}</figcaption>
  <slot />
</figure>

<style>
  .figure {
    display: flex;
    flex-direction: column;
    gap: 22px;
    min-width: 0;
    margin: 0;
    padding: 28px;
    border: var(--border-normal);
    background: var(--color-paper-raised);
  }

  .figure--bare {
    padding: 0;
    border: none;
    background: none;
  }

  .figure__label {
    color: var(--color-line);
    font-family: var(--font-mono);
    font-size: var(--size-label);
    letter-spacing: var(--size-label-letter-spacing);
    text-transform: var(--size-label-transform);
  }

  /* Phone: a framed figure's caption is its title strip, ruled off across the frame as the phone
     drawings' FIG. 0 card is (PR-62e). */
  @media (max-width: 767px) {
    .figure:not(.figure--bare) {
      padding: 0 var(--space-4) var(--space-4);
    }

    .figure:not(.figure--bare) > .figure__label {
      margin-inline: calc(-1 * var(--space-4));
      padding: 10px var(--space-4);
      border-bottom: var(--border-thin);
      line-height: 1.4;
    }
  }
</style>
