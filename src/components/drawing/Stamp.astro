---
import type { HTMLAttributes } from 'astro/types';

// components.md Stamp: a 96 px rubber stamp rotated −12°, three mono lines (VERIFIED / 2025 /
// BROADCOM), the middle one bold. Verified has an inner ring; pending is a dashed redline ring
// without it, drawn as an SVG stroke so its dash can rotate (§M6, the only infinite animation).
// With `data-reveal="stamp"` it slams down (§M1 stamp) and then the ink bleeds (§M6).
type Props = HTMLAttributes<'p'> & {
  lines: readonly [string, string, string];
  state?: 'verified' | 'pending';
};

const { lines, state = 'verified', class: className, ...rest } = Astro.props;
const [top, middle, bottom] = lines;
---

<p class:list={['stamp', `stamp--${state}`, className]} {...rest}>
  {state === 'pending' && (
    <svg class="stamp__ring" viewBox="0 0 96 96" aria-hidden="true">
      <circle cx="48" cy="48" r="46.75" pathLength="120"></circle>
    </svg>
  )}
  <span>{top}</span>
  <strong>{middle}</strong>
  <span>{bottom}</span>
</p>

<style>
  .stamp {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    width: 96px;
    height: 96px;
    margin: 0;
    border: 2.5px solid var(--color-line);
    border-radius: 50%;
    color: var(--color-line);
    font-family: var(--font-mono);
    font-size: var(--size-micro);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: var(--size-micro-letter-spacing);
    text-align: center;
    transform: rotate(-12deg);
    box-shadow:
      inset 0 0 0 4px var(--color-paper),
      inset 0 0 0 5.5px var(--color-line);
  }

  .stamp--pending {
    position: relative;
    border-color: transparent;
    color: var(--color-redline);
    box-shadow: none;
  }

  /* 24 dashes round the circle, each about 7 px with a 5 px gap, laid over the 2.5 px border. */
  .stamp__ring {
    position: absolute;
    inset: -2.5px;
    overflow: visible;
  }

  .stamp__ring circle {
    fill: none;
    stroke: var(--color-redline);
    stroke-width: 2.5px;
    stroke-dasharray: 3 2;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* One turn of the dash in 12 s; 120 is the path length, a whole number of dash periods. */
    .stamp__ring circle {
      animation: stamp-dash 12s linear infinite;
    }

    /* After the slam (380 ms, src/styles/motion.css) the ring bleeds: scale 1 → 1.03 → 1. `scale`
       composes with the stamp's own rotate. */
    :global(.js) .stamp[data-reveal='stamp'].is-revealed {
      animation-name: reveal-stamp, stamp-bleed;
      animation-duration: 380ms, 260ms;
      animation-timing-function: cubic-bezier(0.2, 0.9, 0.25, 1.15), var(--motion-ease-out);
      animation-delay: var(--reveal-delay, 0ms), calc(var(--reveal-delay, 0ms) + 380ms);
    }
  }

  @keyframes stamp-dash {
    to {
      stroke-dashoffset: -120;
    }
  }

  @keyframes stamp-bleed {
    50% {
      scale: 1.03;
    }
  }
</style>
