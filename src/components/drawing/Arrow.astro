---
import type { HTMLAttributes } from 'astro/types';

// components.md Arrow: the flow between two Boxes, a mono arrow with an optional label above
// ("JWT"). The arrow itself is decoration; a label is read.
type Props = HTMLAttributes<'span'> & {
  direction?: 'right' | 'down' | 'left' | 'up';
  label?: string;
};

const GLYPHS = { right: '⟶', down: '↓', left: '⟵', up: '↑' } as const;

const { direction = 'right', label, class: className, ...rest } = Astro.props;
---

<span class:list={['arrow', `arrow--${direction}`, className]} {...rest}>
  {label && <span class="arrow__label">{label}</span>}
  <span aria-hidden="true">{GLYPHS[direction]}</span>
</span>

<style>
  .arrow {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    color: var(--color-line);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.3;
    text-align: center;
  }

  .arrow--down,
  .arrow--up {
    flex-direction: row;
    gap: var(--space-2);
  }
</style>
