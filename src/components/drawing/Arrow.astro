---
import type { HTMLAttributes } from 'astro/types';

// components.md Arrow: the flow between two Boxes, a mono arrow with an optional label above
// ("JWT"). The arrow itself is decoration; a label is read. `mini` is the register card's: a short
// arrow at text size, and a vertical one leads its label ("↓ generates"). `turns` is a right arrow
// that points down below 768 px, where a figure's row becomes a column. `data-flow` marks it for a
// figure's reveal, which draws the arrows in DOM (= data-flow) order (docs/conventions/motion.md).
type Props = HTMLAttributes<'span'> & {
  direction?: 'right' | 'down' | 'left' | 'up';
  label?: string;
  mini?: boolean;
  turns?: boolean;
};

const GLYPHS = { right: '⟶', down: '↓', left: '⟵', up: '↑' } as const;
const MINI_GLYPHS = { right: '→', down: '↓', left: '←', up: '↑' } as const;

const {
  direction = 'right',
  label,
  mini = false,
  turns = false,
  class: className,
  ...rest
} = Astro.props;
const glyphs = mini ? MINI_GLYPHS : GLYPHS;
---

<span
  class:list={['arrow', `arrow--${turns ? 'turns' : direction}`, mini && 'arrow--mini', className]}
  data-flow
  {...rest}
>
  {label && <span class="arrow__label">{label}</span>}
  {turns ? (
    <>
      <span class="arrow__glyph--wide" aria-hidden="true">
        {glyphs.right}
      </span>
      <span class="arrow__glyph--narrow" aria-hidden="true">
        {glyphs.down}
      </span>
    </>
  ) : (
    <span aria-hidden="true">{glyphs[direction]}</span>
  )}
</span>

<style>
  .arrow {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    color: var(--color-line);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.3;
    text-align: center;
  }

  .arrow--down,
  .arrow--up {
    flex-direction: row;
    gap: var(--space-2);
  }

  .arrow__glyph--narrow {
    display: none;
  }

  /* A figure's reveal wipes each arrow in along its direction (src/styles/motion.css). */
  .arrow--down {
    --reveal-clip: inset(0 0 100% 0);
  }

  .arrow--up {
    --reveal-clip: inset(100% 0 0 0);
  }

  .arrow--left {
    --reveal-clip: inset(0 0 0 100%);
  }

  @media (max-width: 767px) {
    .arrow--turns {
      flex-direction: row;
      gap: var(--space-2);
      --reveal-clip: inset(0 0 100% 0);
    }

    .arrow__glyph--wide {
      display: none;
    }

    .arrow__glyph--narrow {
      display: inline;
    }
  }

  .arrow--mini.arrow--right,
  .arrow--mini.arrow--left {
    font-size: var(--size-body);
  }

  .arrow--mini.arrow--down,
  .arrow--mini.arrow--up {
    flex-direction: row-reverse;
    gap: var(--space-1);
  }
</style>
