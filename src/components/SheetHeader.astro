---
import type { SheetKey } from '../content/schemas';
import { CV_PATH, SITE_URL } from '../config';
import { t } from '../i18n/content';
import { alternate, LANGS, localize, type Lang } from '../i18n/paths';
import { SHEETS } from '../i18n/routes';
import { formatSheet } from '../title-block';

// SPEC §3.2, components.md SheetHeader/SheetTab: monogram cell, the five sheet tabs, then the
// utility cluster (language, theme, CV). Not drawn: the utilities sit in their own cell at the
// right; below 1280 px they share the first row with the monogram and the tabs take a full row.
// Phone (< 768 px, design/screens/overview-default-light-390): one 56 px row of cells — monogram,
// "SHEET 0n / 05" over the sheet name, the language switch, the theme swatch. The sheets move to
// the tab bar fixed to the screen bottom (SheetTabBar), the CV to Sheet 01's buttons and the footer.
interface Props {
  lang: Lang;
  /** The sheet this page belongs to; undefined on the 404 sheet (no tab is current). */
  sheet: SheetKey | undefined;
}

const { lang, sheet } = Astro.props;
const ui = await t(lang);
const domain = new URL(SITE_URL).host;
const here = Astro.url.pathname;
const pad = (n: number) => String(n).padStart(2, '0');
const current = SHEETS.find(({ key }) => key === sheet);
const langLinks = LANGS.map((code) => ({
  code,
  href: code === lang ? here : alternate(lang, here),
  current: code === lang,
}));
const otherLang = LANGS.find((code) => code !== lang) ?? lang;
---

<header class="sheet-header" transition:persist="sheet-header">
  <a class="sheet-header__mark" href={localize(lang, '/')}>
    <span class="sheet-header__monogram">{ui.monogram.initials}</span>
    <span class="sheet-header__set">
      <span class="sheet-header__set-name">{ui.monogram.set}</span>
      <span class="sheet-header__domain">{domain}</span>
    </span>
  </a>

  <p class="sheet-header__current">
    <span class="sheet-header__current-number">
      {ui.sheet} {formatSheet(current?.number, SHEETS.length)}
    </span>
    {current && <span class="sheet-header__current-name">{ui.sheets[current.key]}</span>}
  </p>

  <nav class="sheet-header__tabs">
    {SHEETS.map(({ key, number, path }) => (
      <a
        class="sheet-tab"
        href={localize(lang, path)}
        aria-current={key === sheet ? 'page' : undefined}
      >
        {key === sheet && <span class="sheet-tab__fill" aria-hidden="true" />}
        <span class="sheet-tab__number">
          {ui.sheet} {pad(number)}
        </span>
        <span class="sheet-tab__name">{ui.sheets[key]}</span>
      </a>
    ))}
  </nav>

  <div class="sheet-header__utils">
    <span class="sheet-header__langs">
      {langLinks.map(({ code, href, current }) => (
        <a
          class="sheet-header__util sheet-header__lang"
          href={href}
          hreflang={code}
          lang={code}
          aria-current={current ? 'true' : undefined}
        >
          {ui.languages[code]}
        </a>
      ))}
    </span>
    <!-- Phone: one cell, both codes shown (the current one underlined), the link goes to the other. -->
    <a
      class="sheet-header__util sheet-header__lang-switch"
      href={langLinks.find(({ code }) => code === otherLang)?.href}
      hreflang={otherLang}
      lang={otherLang}
    >
      {langLinks.map(({ code, current }, i) => (
        <>
          {i > 0 && <span aria-hidden="true">/</span>}
          <span
            class:list={['sheet-header__lang-code', { 'is-current': current }]}
            aria-hidden={current ? 'true' : undefined}
          >
            {ui.languages[code]}
          </span>
        </>
      ))}
    </a>
    <!-- Label and name follow the theme on screen through CSS (no wrong label before the script
         runs, live when the system changes); the script only toggles and remembers. -->
    <button class="sheet-header__util sheet-header__theme" type="button" data-theme-switch>
      <span class="sheet-header__swatch" aria-hidden="true"></span>
      <span class="sheet-header__theme-state" data-when="paper">
        <span class="sheet-header__theme-label" aria-hidden="true">
          {ui.theme.paper}
        </span>
        <span class="sr-only">{ui.theme.toBlueprint}</span>
      </span>
      <span class="sheet-header__theme-state" data-when="blueprint">
        <span class="sheet-header__theme-label" aria-hidden="true">
          {ui.theme.blueprint}
        </span>
        <span class="sr-only">{ui.theme.toPaper}</span>
      </span>
    </button>
    <a
      class="sheet-header__util sheet-header__cv"
      href={CV_PATH}
      target="_blank"
      rel="noopener"
      data-astro-prefetch="false"
    >
      {ui.cv}
    </a>
  </div>
</header>

<script>
  import { effectiveTheme, otherTheme, THEME_STORAGE_KEY } from '../theme';
  import { revealTheme } from '../view-transitions';

  // SPEC §3.3: every theme button flips paper ↔ blueprint and remembers
  // the choice; until then the theme follows the system (tokens.css), as the head script left it.
  // motion.md §M7: the new theme washes in as a circle growing from the button. Listened for once,
  // on the document: the header persists across sheet changes (src/router.ts).
  const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
  document.addEventListener('click', (event) => {
    const button = event.target instanceof Element && event.target.closest('[data-theme-switch]');
    if (!button) return;
    const root = document.documentElement;
    const next = otherTheme(effectiveTheme(root.dataset.theme, systemDark.matches));
    revealTheme(() => {
      root.dataset.theme = next;
    }, button);
    try {
      localStorage.setItem(THEME_STORAGE_KEY, next);
    } catch {
      // Storage blocked: the choice holds for this visit only.
    }
  });
</script>

<style>
  .sheet-header {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    border-bottom: var(--border-thin);
    font-family: var(--font-mono);
  }

  .sheet-header a {
    color: var(--color-ink);
    text-decoration: none;
  }

  /* Monogram cell, as drawn: 38 px square, 2 px ink border, MG in Archivo 800. */
  .sheet-header__mark {
    display: flex;
    flex: none;
    align-items: center;
    gap: 14px;
    padding: var(--space-4) var(--space-5);
    border-right: var(--border-thin);
  }

  .sheet-header__monogram {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: var(--border-strong);
    font-family: var(--font-display);
    font-size: 15px;
    font-stretch: 112%;
    font-weight: 800;
  }

  .sheet-header__set {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 11px;
    letter-spacing: 0.08em;
  }

  .sheet-header__set-name {
    font-weight: 600;
  }

  .sheet-header__domain {
    color: var(--color-muted);
  }

  .sheet-header__tabs {
    display: flex;
    flex: 1 1 700px;
    font-size: var(--size-label);
    letter-spacing: 0.04em;
  }

  /* SheetTab: SHEET 0n (10 px muted) over the name (12 px mono), 1 px ink rule on the right. A tab
     never shrinks below its name (min-width stays auto, the name never wraps): the long one
     ("Certifications", NL "Certificeringen") takes its width from the shorter tabs instead. */
  .sheet-tab {
    display: flex;
    flex: 1 1 140px;
    flex-direction: column;
    justify-content: center;
    gap: 3px;
    padding: var(--space-3) 18px;
    border-right: var(--border-thin);
  }

  .sheet-tab__number {
    color: var(--color-muted);
    font-size: var(--size-micro);
  }

  /* Hover and keyboard focus: an underline draws under the name, left to right (motion.md §M6). */
  .sheet-tab__name {
    position: relative;
    align-self: flex-start;
    white-space: nowrap;
  }

  .sheet-tab__name::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--motion-fast) var(--motion-ease-plot);
  }

  .sheet-tab:is(:hover, :focus-visible) .sheet-tab__name::after {
    transform: scaleX(1);
  }

  /* The ink fill is its own layer under the text, so it can slide between sheets (motion.md §M2,
     src/styles/transitions.css) and wipe in on the first view (§M1, plotting.css). */
  .sheet-header .sheet-tab[aria-current='page'] {
    position: relative;
    isolation: isolate;
    color: var(--color-ink-on-fill);
  }

  .sheet-tab__fill {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-ink);
  }

  .sheet-tab[aria-current='page'] .sheet-tab__number {
    color: inherit;
    opacity: 0.7;
  }

  .sheet-tab[aria-current='page'] .sheet-tab__name::after {
    display: none;
  }

  /* Utility cluster: EN/NL (current one underlined), theme switch with swatch, CV. */
  .sheet-header__utils {
    display: flex;
    flex: none;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-1) var(--space-2);
    padding: var(--space-2) var(--space-4);
    font-size: var(--size-label);
    letter-spacing: 0.04em;
  }

  .sheet-header__langs {
    display: flex;
  }

  .sheet-header__util {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-width: 44px;
    min-height: 44px;
    padding: 0 var(--space-2);
    border: 0;
    background: none;
    color: var(--color-ink);
    font: inherit;
    letter-spacing: inherit;
    cursor: pointer;
  }

  .sheet-header .sheet-header__lang {
    color: var(--color-muted);
  }

  .sheet-header .sheet-header__lang[aria-current='true'] {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .sheet-header__swatch {
    width: 10px;
    height: 10px;
    border: var(--border-thin);
    background: var(--color-paper);
  }

  /* The label names the theme on screen, the accessible name the switch (copy.md Global); the
     same rule as tokens.css decides which: a choice on <html>, else the system preference. */
  .sheet-header__theme-state[data-when='blueprint'],
  :global([data-theme='blueprint']) .sheet-header__theme-state[data-when='paper'] {
    display: none;
  }

  :global([data-theme='blueprint']) .sheet-header__theme-state[data-when='blueprint'] {
    display: inline;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='paper'])) .sheet-header__theme-state[data-when='paper'] {
      display: none;
    }

    :global(:root:not([data-theme='paper'])) .sheet-header__theme-state[data-when='blueprint'] {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet-tab__name::after {
      transition: none;
    }
  }

  /* Monogram + utilities on the first row, the five tabs on their own full row. */
  @media (max-width: 1279px) {
    .sheet-header__utils {
      margin-left: auto;
    }

    .sheet-header__tabs {
      flex-basis: 100%;
      order: 1;
      border-top: var(--border-thin);
    }

    .sheet-tab:last-child {
      border-right: 0;
    }
  }

  /* Tablet: the five tabs stay in one row. */
  @media (max-width: 1023px) {
    .sheet-tab {
      flex-basis: 0;
      padding-inline: var(--space-3);
    }
  }

  /* Phone only: the current sheet and the one-cell language switch. */
  .sheet-header__current,
  .sheet-header__lang-switch {
    display: none;
  }

  /* Phone (design/screens/overview-default-light-390): one 56 px row of ruled cells. */
  @media (max-width: 767px) {
    .sheet-header {
      flex-wrap: nowrap;
      height: 56px;
    }

    .sheet-header__mark {
      justify-content: center;
      width: 56px;
      padding: 0;
    }

    .sheet-header__monogram {
      width: 30px;
      height: 30px;
      font-size: 12px;
    }

    /* The set name stays in the link's accessible name; only the MG square shows. */
    .sheet-header__set {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .sheet-header__current {
      display: flex;
      flex: 1 1 auto;
      flex-direction: column;
      justify-content: center;
      gap: 2px;
      min-width: 0;
      margin: 0;
      padding: 0 var(--space-3);
    }

    .sheet-header__current > span {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .sheet-header__current-number {
      color: var(--color-muted);
      font-size: var(--size-micro);
      letter-spacing: var(--size-micro-letter-spacing);
    }

    .sheet-header__current-name {
      font-size: 13px;
      letter-spacing: 0.04em;
    }

    .sheet-header__tabs,
    .sheet-header__langs,
    .sheet-header__cv,
    .sheet-header__theme-label {
      display: none;
    }

    .sheet-header__utils {
      flex-wrap: nowrap;
      align-items: stretch;
      gap: 0;
      margin-left: 0;
      padding: 0;
      font-size: var(--size-micro);
    }

    .sheet-header__utils > .sheet-header__util {
      width: 56px;
      padding: 0;
      border-left: var(--border-thin);
    }

    .sheet-header .sheet-header__lang-switch {
      display: inline-flex;
      gap: 2px;
      color: var(--color-muted);
    }

    .sheet-header__lang-code.is-current {
      color: var(--color-ink);
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    /* The swatch shows both themes, split on the diagonal. */
    .sheet-header__swatch {
      width: 16px;
      height: 16px;
      border-width: 1.5px;
      background: linear-gradient(135deg, var(--color-paper) 50%, var(--color-ink) 50%);
    }
  }

  /* Narrow phones: the utility cells give the sheet name room, still 44 px+ targets. */
  @media (max-width: 359px) {
    .sheet-header__mark,
    .sheet-header__utils > .sheet-header__util {
      width: 48px;
    }

    .sheet-header__current {
      padding: 0 var(--space-2);
    }

    .sheet-header__current-name {
      font-size: var(--size-label);
    }
  }
</style>
