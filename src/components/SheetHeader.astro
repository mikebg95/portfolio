---
import type { SheetKey } from '../content/schemas';
import { CV_PATH, SITE_URL } from '../config';
import { t } from '../i18n/content';
import { alternate, LANGS, localize, type Lang } from '../i18n/paths';
import { SHEETS } from '../i18n/routes';

// SPEC §3.2, components.md SheetHeader/SheetTab: monogram cell, the five sheet tabs, then the
// utility cluster (language, theme, CV). Not drawn: the utilities sit in their own cell at the
// right; below 1280 px they share the first row with the monogram and the tabs take a full row.
// Phone (< 768 px, SheetIndexPanel): monogram + current sheet + SHEETS button opening a panel with
// the five sheets, language, theme and CV; without JS the panel is a <details>.
interface Props {
  lang: Lang;
  /** The sheet this page belongs to; undefined on the 404 sheet (no tab is current). */
  sheet: SheetKey | undefined;
}

const { lang, sheet } = Astro.props;
const ui = await t(lang);
const domain = new URL(SITE_URL).host;
const here = Astro.url.pathname;
const pad = (n: number) => String(n).padStart(2, '0');
const current = SHEETS.find(({ key }) => key === sheet);
const langLinks = LANGS.map((code) => ({
  code,
  href: code === lang ? here : alternate(lang, here),
  current: code === lang,
}));
const PANEL_ID = 'sheet-index-panel';
---

<header class="sheet-header">
  <a class="sheet-header__mark" href={localize(lang, '/')}>
    <span class="sheet-header__monogram">{ui.monogram.initials}</span>
    <span class="sheet-header__set">
      <span class="sheet-header__set-name">{ui.monogram.set}</span>
      <span class="sheet-header__domain">{domain}</span>
    </span>
  </a>

  {current && (
    <p class="sheet-header__current">
      <span class="sheet-tab__number">
        {ui.sheet} {pad(current.number)}
      </span>
      <span>{ui.sheets[current.key]}</span>
    </p>
  )}

  <nav class="sheet-header__tabs">
    {SHEETS.map(({ key, number, path }) => (
      <a
        class="sheet-tab"
        href={localize(lang, path)}
        aria-current={key === sheet ? 'page' : undefined}
      >
        {key === sheet && <span class="sheet-tab__fill" aria-hidden="true" />}
        <span class="sheet-tab__number">
          {ui.sheet} {pad(number)}
        </span>
        <span class="sheet-tab__name">{ui.sheets[key]}</span>
      </a>
    ))}
  </nav>

  <div class="sheet-header__utils">
    <span class="sheet-header__langs">
      {langLinks.map(({ code, href, current }) => (
        <a
          class="sheet-header__util sheet-header__lang"
          href={href}
          hreflang={code}
          lang={code}
          aria-current={current ? 'true' : undefined}
        >
          {ui.languages[code]}
        </a>
      ))}
    </span>
    <!-- Label and name follow the theme on screen through CSS (no wrong label before the script
         runs, live when the system changes); the script only toggles and remembers. -->
    <button class="sheet-header__util sheet-header__theme" type="button" data-theme-switch>
      <span class="sheet-header__swatch" aria-hidden="true"></span>
      <span class="sheet-header__theme-state" data-when="paper">
        <span class="sheet-header__theme-label" aria-hidden="true">
          {ui.theme.paper}
        </span>
        <span class="sr-only">{ui.theme.toBlueprint}</span>
      </span>
      <span class="sheet-header__theme-state" data-when="blueprint">
        <span class="sheet-header__theme-label" aria-hidden="true">
          {ui.theme.blueprint}
        </span>
        <span class="sr-only">{ui.theme.toPaper}</span>
      </span>
    </button>
    <a class="sheet-header__util" href={CV_PATH} target="_blank" rel="noopener">
      {ui.cv}
    </a>
  </div>

  <div class="sheet-index" data-sheet-index>
    <button
      class="sheet-header__util sheet-index__toggle"
      type="button"
      hidden
      aria-expanded="false"
      aria-controls={PANEL_ID}
      aria-label={ui.sheetIndex.openLabel}
      data-open-text={ui.sheetIndex.open}
      data-close-text={ui.sheetIndex.close}
    >
      {ui.sheetIndex.open}
    </button>
    <details class="sheet-index__fallback">
      <summary class="sheet-header__util sheet-index__toggle">{ui.sheetIndex.open}</summary>
      <div class="sheet-index__panel" id={PANEL_ID}>
        <nav>
          {SHEETS.map(({ key, number, path }) => (
            <a
              class="sheet-index__sheet"
              href={localize(lang, path)}
              aria-current={key === sheet ? 'page' : undefined}
            >
              <span class="sheet-index__number">{pad(number)}</span>
              <span>{ui.sheets[key]}</span>
            </a>
          ))}
        </nav>
        <div class="sheet-index__utils">
          <span class="sheet-index__cell">
            {langLinks.map(({ code, href, current }) => (
              <a
                class="sheet-header__util sheet-header__lang"
                href={href}
                hreflang={code}
                lang={code}
                aria-current={current ? 'true' : undefined}
              >
                {ui.languages[code]}
              </a>
            ))}
          </span>
          <span class="sheet-index__cell">
            <button class="sheet-header__util sheet-header__theme" type="button" data-theme-switch>
              <span class="sheet-header__swatch" aria-hidden="true"></span>
              <span class="sheet-header__theme-state" data-when="paper">
                <span class="sheet-header__theme-label" aria-hidden="true">
                  {ui.theme.paper}
                </span>
                <span class="sr-only">{ui.theme.toBlueprint}</span>
              </span>
              <span class="sheet-header__theme-state" data-when="blueprint">
                <span class="sheet-header__theme-label" aria-hidden="true">
                  {ui.theme.blueprint}
                </span>
                <span class="sr-only">{ui.theme.toPaper}</span>
              </span>
            </button>
          </span>
          <span class="sheet-index__cell">
            <a class="sheet-header__util" href={CV_PATH} target="_blank" rel="noopener">
              {ui.cv}
            </a>
          </span>
        </div>
      </div>
    </details>
  </div>
</header>

<script>
  // Enhances the <details> fallback into a button + panel (SPEC §3.2): clip-path wipe, closes on
  // Escape, selection and outside tap, traps focus while open and hands it back to the button.
  const root = document.querySelector<HTMLElement>('[data-sheet-index]');
  const button = root?.querySelector<HTMLButtonElement>('button[aria-controls]');
  const details = root?.querySelector('details');
  const panel = button && document.getElementById(button.getAttribute('aria-controls') ?? '');

  if (root && button && details && panel) {
    const openLabel = button.getAttribute('aria-label') ?? '';
    details.replaceWith(panel);
    panel.hidden = true;
    panel.dataset.state = 'closed';
    button.hidden = false;

    const isOpen = () => button.getAttribute('aria-expanded') === 'true';
    const focusables = () => [
      button,
      ...panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
    ];

    const onKey = (event: KeyboardEvent) => {
      if (event.key === 'Escape') {
        close();
        return;
      }
      if (event.key !== 'Tab') return;
      const items = focusables();
      const first = items[0];
      const last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    };

    const onPointer = (event: PointerEvent) => {
      if (!root.contains(event.target as Node)) close(false);
    };

    function open() {
      panel!.hidden = false;
      panel!.getBoundingClientRect(); // start the wipe from the closed clip-path
      panel!.dataset.state = 'open';
      button!.setAttribute('aria-expanded', 'true');
      button!.removeAttribute('aria-label');
      button!.textContent = button!.dataset.closeText ?? '';
      document.addEventListener('keydown', onKey);
      document.addEventListener('pointerdown', onPointer);
    }

    function close(returnFocus = true) {
      if (!isOpen()) return;
      panel!.dataset.state = 'closed';
      button!.setAttribute('aria-expanded', 'false');
      button!.setAttribute('aria-label', openLabel);
      button!.textContent = button!.dataset.openText ?? '';
      document.removeEventListener('keydown', onKey);
      document.removeEventListener('pointerdown', onPointer);
      if (returnFocus) button!.focus();
      // Hide once the wipe has run (getAnimations flushes style, so it sees the new transition);
      // reopening cancels it (rejects) and keeps the panel shown. Reduced motion: none, hide now.
      Promise.all(panel!.getAnimations().map((animation) => animation.finished))
        .then(() => {
          if (!isOpen()) panel!.hidden = true;
        })
        .catch(() => {});
    }

    button.addEventListener('click', () => (isOpen() ? close() : open()));
    panel.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) close(false);
    });
  }
</script>

<script>
  import { effectiveTheme, otherTheme, THEME_STORAGE_KEY } from '../theme';
  import { revealTheme } from '../view-transitions';

  // SPEC §3.3: every theme button (header and phone panel) flips paper ↔ blueprint and remembers
  // the choice; until then the theme follows the system (tokens.css), as the head script left it.
  // motion.md §M7: the new theme washes in as a circle growing from the button.
  const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
  for (const button of document.querySelectorAll('[data-theme-switch]')) {
    button.addEventListener('click', () => {
      const root = document.documentElement;
      const next = otherTheme(effectiveTheme(root.dataset.theme, systemDark.matches));
      revealTheme(() => {
        root.dataset.theme = next;
      }, button);
      try {
        localStorage.setItem(THEME_STORAGE_KEY, next);
      } catch {
        // Storage blocked: the choice holds for this page only.
      }
    });
  }
</script>

<style>
  .sheet-header {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    border-bottom: var(--border-thin);
    font-family: var(--font-mono);
  }

  .sheet-header a {
    color: var(--color-ink);
    text-decoration: none;
  }

  /* Monogram cell, as drawn: 38 px square, 2 px ink border, MG in Archivo 800. */
  .sheet-header__mark {
    display: flex;
    flex: none;
    align-items: center;
    gap: 14px;
    padding: var(--space-4) var(--space-5);
    border-right: var(--border-thin);
  }

  .sheet-header__monogram {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: var(--border-strong);
    font-family: var(--font-display);
    font-size: 15px;
    font-stretch: 112%;
    font-weight: 800;
  }

  .sheet-header__set {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 11px;
    letter-spacing: 0.08em;
  }

  .sheet-header__set-name {
    font-weight: 600;
  }

  .sheet-header__domain {
    color: var(--color-muted);
  }

  .sheet-header__tabs {
    display: flex;
    flex: 1 1 700px;
    font-size: var(--size-label);
    letter-spacing: 0.04em;
  }

  /* SheetTab: SHEET 0n (10 px muted) over the name (12 px mono), 1 px ink rule on the right. */
  .sheet-tab {
    display: flex;
    flex: 1 1 140px;
    flex-direction: column;
    justify-content: center;
    gap: 3px;
    min-width: 0;
    padding: var(--space-3) 18px;
    border-right: var(--border-thin);
  }

  .sheet-tab__number {
    color: var(--color-muted);
    font-size: var(--size-micro);
  }

  /* Hover and keyboard focus: an underline draws under the name, left to right (motion.md §M6). */
  .sheet-tab__name {
    position: relative;
    align-self: flex-start;
    overflow-wrap: anywhere;
  }

  .sheet-tab__name::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--motion-fast) var(--motion-ease-plot);
  }

  .sheet-tab:is(:hover, :focus-visible) .sheet-tab__name::after {
    transform: scaleX(1);
  }

  /* The ink fill is its own layer under the text, so it can slide between sheets (motion.md §M2,
     src/styles/transitions.css) and wipe in on the first view (§M1, plotting.css). */
  .sheet-header .sheet-tab[aria-current='page'] {
    position: relative;
    isolation: isolate;
    color: var(--color-ink-on-fill);
  }

  .sheet-tab__fill {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-ink);
  }

  .sheet-tab[aria-current='page'] .sheet-tab__number {
    color: inherit;
    opacity: 0.7;
  }

  .sheet-tab[aria-current='page'] .sheet-tab__name::after {
    display: none;
  }

  /* Utility cluster: EN/NL (current one underlined), theme switch with swatch, CV. */
  .sheet-header__utils {
    display: flex;
    flex: none;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-1) var(--space-2);
    padding: var(--space-2) var(--space-4);
    font-size: var(--size-label);
    letter-spacing: 0.04em;
  }

  .sheet-header__langs {
    display: flex;
  }

  .sheet-header__util {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-width: 44px;
    min-height: 44px;
    padding: 0 var(--space-2);
    border: 0;
    background: none;
    color: var(--color-ink);
    font: inherit;
    letter-spacing: inherit;
    cursor: pointer;
  }

  .sheet-header .sheet-header__lang {
    color: var(--color-muted);
  }

  .sheet-header .sheet-header__lang[aria-current='true'] {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .sheet-header__swatch {
    width: 10px;
    height: 10px;
    border: var(--border-thin);
    background: var(--color-paper);
  }

  /* The label names the theme on screen, the accessible name the switch (copy.md Global); the
     same rule as tokens.css decides which: a choice on <html>, else the system preference. */
  .sheet-header__theme-state[data-when='blueprint'],
  :global([data-theme='blueprint']) .sheet-header__theme-state[data-when='paper'] {
    display: none;
  }

  :global([data-theme='blueprint']) .sheet-header__theme-state[data-when='blueprint'] {
    display: inline;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='paper'])) .sheet-header__theme-state[data-when='paper'] {
      display: none;
    }

    :global(:root:not([data-theme='paper'])) .sheet-header__theme-state[data-when='blueprint'] {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet-tab__name::after {
      transition: none;
    }
  }

  /* Monogram + utilities on the first row, the five tabs on their own full row. */
  @media (max-width: 1279px) {
    .sheet-header__utils {
      margin-left: auto;
    }

    .sheet-header__tabs {
      flex-basis: 100%;
      order: 1;
      border-top: var(--border-thin);
    }

    .sheet-tab:last-child {
      border-right: 0;
    }
  }

  /* Tablet: the five tabs stay in one row. */
  @media (max-width: 1023px) {
    .sheet-tab {
      flex-basis: 0;
      padding-inline: var(--space-3);
    }
  }

  /* Phone (components.md SheetIndexPanel): monogram, current sheet, SHEETS; the tab row and the
     utility cluster move into the panel. */
  .sheet-header__current,
  .sheet-index {
    display: none;
  }

  .sheet-header [hidden] {
    display: none;
  }

  .sheet-index__toggle {
    list-style: none;
  }

  .sheet-index__toggle::-webkit-details-marker {
    display: none;
  }

  .sheet-index__panel {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    z-index: 5;
    border-top: var(--border-thin);
    border-bottom: var(--border-thin);
    background: var(--color-paper);
    transition: clip-path var(--motion-normal) var(--motion-ease-plot);
  }

  .sheet-index__panel[data-state='closed'] {
    clip-path: inset(0 0 100% 0);
  }

  .sheet-index__sheet {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 56px;
    padding: 0 var(--space-4);
    border-bottom: var(--border-thin);
    font-size: var(--size-label);
    letter-spacing: 0.04em;
  }

  .sheet-index__number {
    color: var(--color-muted);
    font-size: var(--size-micro);
  }

  .sheet-header .sheet-index__sheet[aria-current='page'] {
    background: var(--color-ink);
    color: var(--color-ink-on-fill);
  }

  .sheet-index__sheet[aria-current='page'] .sheet-index__number {
    color: inherit;
    opacity: 0.7;
  }

  .sheet-index__utils {
    display: flex;
    flex-wrap: wrap;
    font-size: var(--size-label);
    letter-spacing: 0.04em;
  }

  .sheet-index__cell {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 var(--space-2);
  }

  .sheet-index__cell + .sheet-index__cell {
    border-left: var(--border-thin);
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet-index__panel {
      transition: none;
    }
  }

  @media (max-width: 767px) {
    .sheet-header {
      position: relative;
      flex-wrap: nowrap;
    }

    .sheet-header__mark {
      padding: var(--space-3);
    }

    /* The set name stays in the link's accessible name; only the MG square shows. */
    .sheet-header__set {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .sheet-header__current {
      display: flex;
      flex: 1 1 auto;
      flex-direction: column;
      justify-content: center;
      gap: 3px;
      min-width: 0;
      margin: 0;
      padding: var(--space-2) var(--space-3);
      font-size: var(--size-label);
      letter-spacing: 0.04em;
    }

    .sheet-header__current > span {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .sheet-index {
      display: flex;
      flex: none;
      align-items: center;
      margin-left: auto;
      padding: 0 var(--space-2);
      border-left: var(--border-thin);
      font-size: var(--size-label);
      letter-spacing: 0.04em;
    }

    .sheet-header__tabs,
    .sheet-header__utils {
      display: none;
    }
  }
</style>
