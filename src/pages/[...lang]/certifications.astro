---
import CertCard from '../../components/certifications/CertCard.astro';
import DisplayHeading from '../../components/drawing/DisplayHeading.astro';
import SheetLabel from '../../components/drawing/SheetLabel.astro';
import { getAllLocalized, sharedId, t } from '../../i18n/content';
import { langPaths, type Lang } from '../../i18n/paths';
import SheetLayout from '../../layouts/SheetLayout.astro';

export function getStaticPaths() {
  return langPaths();
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = await t(lang);
// The inspection record (SPEC §4.5): C-01…C-04 in code order, 2 × 2 from tablet up.
const certs = (await getAllLocalized('certifications', lang)).sort((a, b) =>
  a.data.code.localeCompare(b.data.code),
);
---

<SheetLayout
  lang={lang}
  sheet="certifications"
  title={ui.seo.certifications.title}
  description={ui.seo.certifications.description}
>
  <section class="sheet-panel record">
    <div class="record__head">
      <SheetLabel data-plot="label">{ui.certifications.label}</SheetLabel>
      <DisplayHeading as="h1" size="l" data-plot="heading">
        <span class="record__line">{ui.certifications.heading[0]}</span>{' '}
        <span class="record__line">{ui.certifications.heading[1]}</span>
      </DisplayHeading>
      <p class="record__intro" data-plot="hero">
        {ui.certifications.intro}
      </p>
    </div>
    <div class="record__cards" data-reveal="cards">
      {certs.map((entry, i) => (
        <CertCard
          id={sharedId(entry)}
          index={i}
          cert={entry.data}
          dates={ui.dates}
          pending={ui.certifications.pending}
        />
      ))}
    </div>
  </section>
</SheetLayout>

<style>
  .record {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-bottom: 64px;
  }

  /* The display size, capped by the sheet's width so the longest word (INSPECTED, Dutch AFGETEKEND)
     never breaks mid-word on a phone. */
  .record__head {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .record__head :global(h1) {
    font-size: min(var(--size-display-l), 11.5cqi);
  }

  .record__line {
    display: block;
  }

  .record__intro {
    max-width: 640px;
    margin: 0;
    color: var(--color-text-2);
    font-size: var(--size-lead);
    line-height: 1.6;
  }

  .record__cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }

  @media (min-width: 768px) {
    .record__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
