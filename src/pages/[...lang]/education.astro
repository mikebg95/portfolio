---
import { DEFAULT_PART } from '../../assembly';
import DisplayHeading from '../../components/drawing/DisplayHeading.astro';
import SheetLabel from '../../components/drawing/SheetLabel.astro';
import DetailPanel from '../../components/education/DetailPanel.astro';
import ExplodedAssembly from '../../components/education/ExplodedAssembly.astro';
import PartsList from '../../components/education/PartsList.astro';
import { getAllLocalized, t } from '../../i18n/content';
import { langPaths, type Lang } from '../../i18n/paths';
import SheetLayout from '../../layouts/SheetLayout.astro';

export function getStaticPaths() {
  return langPaths();
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = await t(lang);
// The exploded assembly (SPEC §4.6): five parts by item, 1 = the base plate.
const parts = (await getAllLocalized('education', lang)).map((entry) => entry.data);
const partName = (part: (typeof parts)[number]) =>
  ui.education.part.replace('{n}', String(part.item)).replace('{name}', part.balloon);
---

<SheetLayout
  lang={lang}
  sheet="education"
  title={ui.seo.education.title}
  description={ui.seo.education.description}
>
  <section class="sheet-panel education" data-education>
    <div class="education__head">
      <SheetLabel data-plot="label">{ui.education.label}</SheetLabel>
      <DisplayHeading as="h1" size="l" data-plot="heading">
        <span class="education__line">{ui.education.heading[0]}</span>{' '}
        <span class="education__line">{ui.education.heading[1]}</span>
      </DisplayHeading>
      <p class="education__intro" data-plot="hero">
        {ui.education.intro}
      </p>
    </div>
    <div class="education__body">
      <ExplodedAssembly
        parts={parts}
        selected={DEFAULT_PART}
        name={partName}
        label={ui.education.assembly}
      />
      <div class="education__side">
        <div class="education__details">
          {parts.map((part) => (
            <DetailPanel
              part={part}
              lang={lang}
              strings={ui.education}
              data-selected={String(part.item === DEFAULT_PART)}
            />
          ))}
        </div>
        <PartsList parts={parts} selected={DEFAULT_PART} headers={ui.education.parts} />
      </div>
    </div>
  </section>
</SheetLayout>

<script>
  import { partFromHash, partHash } from '../../assembly';

  // SPEC §4.6 / motion.md §M5: a plate, balloon or parts-list row selects its part. Every control
  // carrying `data-part` follows the selection; the URL hash `#part-n` records it and is read on
  // load. Until the first selection the sheet stays as drawn (part 3, nothing dimmed).
  const root = document.querySelector<HTMLElement>('[data-education]');
  if (root) {
    const assembly = root.querySelector<HTMLElement>('.assembly');
    const panels = [...root.querySelectorAll<HTMLElement>('.detail-panel')];
    const items = panels.map((panel) => Number(panel.dataset.part));

    const select = (item: number, wipe: boolean) => {
      const part = String(item);
      assembly?.setAttribute('data-active', '');
      for (const el of root.querySelectorAll<HTMLElement>('button[data-part]')) {
        el.setAttribute('aria-pressed', String(el.dataset.part === part));
        if (el.classList.contains('balloon__mark') && !el.matches('.balloon__mark--pending')) {
          el.classList.toggle('balloon__mark--active', el.dataset.part === part);
        }
      }
      for (const el of root.querySelectorAll<HTMLElement>('.assembly__callout')) {
        el.classList.toggle('assembly__callout--selected', el.dataset.part === part);
      }
      for (const el of root.querySelectorAll<HTMLElement>('tr[data-part]')) {
        el.classList.toggle('parts-list__row--selected', el.dataset.part === part);
      }
      for (const panel of panels) {
        const on = panel.dataset.part === part;
        const shown = panel.dataset.selected === 'true';
        panel.dataset.selected = String(on);
        if (on && !shown && wipe) {
          panel.classList.remove('detail-panel--wipe');
          void panel.offsetWidth;
          panel.classList.add('detail-panel--wipe');
        }
      }
    };

    root.addEventListener('click', (event) => {
      const target = (event.target as Element).closest<HTMLElement>(
        'button[data-part], tr[data-part]',
      );
      if (!target) return;
      const item = Number(target.dataset.part);
      select(item, true);
      history.replaceState(history.state, '', partHash(item));
    });

    root.addEventListener('animationend', (event) => {
      (event.target as Element).classList.remove('detail-panel--wipe');
    });

    // Hovering a row previews its plate's lift.
    for (const row of root.querySelectorAll<HTMLElement>('tr[data-part]')) {
      const plate = root.querySelector(`.plate[data-part="${row.dataset.part}"]`);
      row.addEventListener('mouseenter', () => plate?.classList.add('plate--preview'));
      row.addEventListener('mouseleave', () => plate?.classList.remove('plate--preview'));
    }

    const fromHash = () => {
      const item = partFromHash(location.hash, items);
      if (item !== undefined) select(item, false);
    };
    fromHash();
    addEventListener('hashchange', fromHash);
    requestAnimationFrame(() => assembly?.setAttribute('data-ready', ''));
  }
</script>

<style>
  .education {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-bottom: 64px;
  }

  /* The display size, capped by the sheet's width so ASSEMBLED never breaks mid-word on a phone. */
  .education__head {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .education__head :global(h1) {
    font-size: min(var(--size-display-l), 13cqi);
  }

  .education__line {
    display: block;
  }

  .education__intro {
    max-width: 640px;
    margin: 0;
    color: var(--color-text-2);
    font-size: var(--size-lead);
    line-height: 1.6;
  }

  /* Assembly beside the detail panel and parts list on desktop; stacked below it otherwise. */
  .education__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }

  .education__side {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  @media (min-width: 1024px) {
    .education__body {
      grid-template-columns: minmax(0, 1fr) minmax(0, 460px);
      align-items: start;
    }
  }
</style>
