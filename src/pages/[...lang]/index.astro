---
import { t } from '../../i18n/content';
import { langPaths, type Lang } from '../../i18n/paths';
import Hero from '../../components/overview/Hero.astro';
import HowIWork from '../../components/overview/HowIWork.astro';
import InProgress from '../../components/overview/InProgress.astro';
import SpecNotes from '../../components/overview/SpecNotes.astro';
import SheetLayout from '../../layouts/SheetLayout.astro';

export function getStaticPaths() {
  return langPaths();
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = await t(lang);
---

<SheetLayout lang={lang} sheet="overview" title={ui.seo.overview.title}>
  <Hero lang={lang} />
  <HowIWork lang={lang} />
  <SpecNotes lang={lang} />
  <InProgress lang={lang} />
</SheetLayout>
