---
import DisplayHeading from '../../components/drawing/DisplayHeading.astro';
import SheetLabel from '../../components/drawing/SheetLabel.astro';
import ExperienceBreak from '../../components/experience/ExperienceBreak.astro';
import ExperienceDetail from '../../components/experience/ExperienceDetail.astro';
import ExperienceRuler from '../../components/experience/ExperienceRuler.astro';
import Timeline from '../../components/experience/Timeline.astro';
import { getAllLocalized, t } from '../../i18n/content';
import { langPaths, type Lang } from '../../i18n/paths';
import { SHEETS } from '../../i18n/routes';
import SheetLayout from '../../layouts/SheetLayout.astro';
import { yearMarks } from '../../timeline';

export function getStaticPaths() {
  return langPaths();
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = await t(lang);
const entries = (await getAllLocalized('experience', lang)).map((e) => e.data);

// Newest first (`order`). Top-level entries are numbered 02.1, 02.2 …; an employer's assignments
// (`parent`) nest in its block as 02.1a, 02.1b … (docs/RECORD.md 2026-10-04, PR-60).
type Entry = (typeof entries)[number];
const sheet = String(SHEETS.find((s) => s.key === 'experience')?.number).padStart(2, '0');
const top = entries.filter((e) => e.parent === undefined);
const assignmentsOf = (entry: Entry) => entries.filter((e) => e.parent === entry.id);
const number = (entry: Entry) => `${sheet}.${top.indexOf(entry) + 1}`;
const letter = (i: number) => String.fromCharCode(97 + i);

// Below 768 px the details are the timeline (experience-default-light-390): a year ruler to scale
// down their left, at least 14 px a month, the employer's bracket and the entries as cards.
const { months, marks } = yearMarks(
  entries.filter((e) => e.kind !== 'employer'),
  new Date(),
);
const toggle = ui.experience.toggle;
---

<SheetLayout
  lang={lang}
  sheet="experience"
  title={ui.seo.experience.title}
  description={ui.seo.experience.description}
>
  <section class="sheet-panel experience-head">
    <SheetLabel data-plot="label">{ui.experience.label}</SheetLabel>
    <DisplayHeading as="h1" size="l" data-plot="heading">
      <span class="experience-head__line">{ui.experience.heading[0]}</span>{' '}
      <span class="experience-head__line">{ui.experience.heading[1]}</span>
    </DisplayHeading>
    <Timeline lang={lang} />
  </section>
  <section class="sheet-panel experience-details" style={`--months: ${months}`}>
    <ExperienceRuler marks={marks} now={ui.dates.now} />
    {top.map((entry) =>
      entry.kind === 'break' ? (
        <ExperienceBreak entry={entry} dates={ui.dates} />
      ) : entry.kind === 'role' ? (
        <ExperienceDetail entry={entry} number={number(entry)} dates={ui.dates} toggle={toggle} />
      ) : (
        <ExperienceDetail entry={entry} number={number(entry)} dates={ui.dates} toggle={toggle}>
          {assignmentsOf(entry).map((assignment, i) =>
            assignment.kind === 'break' ? (
              <ExperienceBreak
                entry={assignment}
                number={`${number(entry)}${letter(i)}`}
                dates={ui.dates}
              />
            ) : (
              <ExperienceDetail
                entry={assignment}
                number={`${number(entry)}${letter(i)}`}
                dates={ui.dates}
                toggle={toggle}
              />
            ),
          )}
        </ExperienceDetail>
      ),
    )}
  </section>
</SheetLayout>

<style>
  .experience-head {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .experience-head__line {
    display: block;
  }

  .experience-head :global(.timeline) {
    margin-top: var(--space-7);
  }

  /* The blocks pad themselves; 1 px rules between them, as drawn. */
  .experience-details {
    padding: 0 0 var(--space-4);
  }

  .experience-details > :global(article + article) {
    border-top: 1px solid var(--color-rule);
  }

  /* A bar's link lands its block clear of the pinned timeline (src/timeline-motion.ts sets it). */
  .experience-details :global(article) {
    scroll-margin-top: var(--timeline-pinned, 0px);
  }

  /* Phone (experience-default-light-390): the ruler down the left, the Conspect bracket beside it,
     the entries as a column of cards; the bars timeline gives way to it. */
  @media (max-width: 767px) {
    .experience-head :global(.timeline) {
      display: none;
    }

    .experience-details {
      --experience-ruler: 40px;
      --experience-cards: 70px;

      position: relative;
      display: flex;
      flex-direction: column;
      gap: 10px;
      min-height: calc(var(--months) * 14px);
      padding: var(--space-2) var(--sheet-content-padding-phone)
        calc(var(--sheet-content-padding-phone) + 18px)
        calc(var(--sheet-content-padding-phone) + var(--experience-cards));
    }

    .experience-details > :global(article + article) {
      border-top: 0;
    }
  }

  /* Narrow phones: a slimmer ruler and bracket leave the cards their width. */
  @media (max-width: 359px) {
    .experience-details {
      --experience-ruler: 32px;
      --experience-cards: 58px;
    }
  }
</style>
