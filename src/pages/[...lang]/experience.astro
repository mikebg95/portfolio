---
import { t } from '../../i18n/content';
import { langPaths, type Lang } from '../../i18n/paths';
import SheetLayout from '../../layouts/SheetLayout.astro';

export function getStaticPaths() {
  return langPaths();
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = await t(lang);
---

<SheetLayout lang={lang} title={ui.seo.experience.title}>
  <h1>{ui.sheets.experience}</h1>
</SheetLayout>
