---
import { t } from '../../i18n/content';
import { langPaths, type Lang } from '../../i18n/paths';
import SheetLayout from '../../layouts/SheetLayout.astro';

export function getStaticPaths() {
  return langPaths();
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = await t(lang);
---

<SheetLayout lang={lang} sheet="experience" title={ui.seo.experience.title}>
  <section class="sheet-panel">
    <h1>{ui.sheets.experience}</h1>
    {/* Target of the Overview's in-progress link; PR-20 (detail block 02.1) takes the id over. */}
    <div id="optiecon"></div>
  </section>
</SheetLayout>
