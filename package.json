{
  "name": "michaelgoldman-dev",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "tokens": "node scripts/tokens.ts",
    "dev": "npm run tokens && astro dev --port 4321",
    "build": "npm run tokens && astro build",
    "preview": "astro preview --port 4321",
    "astro": "astro",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run test:e2e && npm run lhci",
    "screenshot": "node scripts/readme-screenshot.ts"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.3.5",
    "fontkit": "^2.0.4",
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/fontkit": "^2.0.9",
    "@types/js-yaml": "^4.0.9",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "js-yaml": "^4.3.2",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "wawoff2": "^2.0.1"
  }
}
