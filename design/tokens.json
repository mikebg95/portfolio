{
  "color": {
    "desk":        { "light": "#E9E5DA", "dark": "#0A1428", "note": "page background around the sheet" },
    "paper":       { "light": "#F4F1E8", "dark": "#10264A", "note": "sheet background" },
    "paper-raised":{ "light": "rgba(244,241,232,0.92)", "dark": "rgba(16,38,74,0.92)", "note": "panels/cards over the grid" },
    "ink":         { "light": "#18233A", "dark": "#E6EEFA", "note": "text, frame, strong lines, active tab fill" },
    "ink-on-fill": { "light": "#F4F1E8", "dark": "#10264A", "note": "text on an ink-filled surface" },
    "text-2":      { "light": "#3A4458", "dark": "#C2D0E6", "note": "body paragraphs" },
    "muted":       { "light": "#5B6372", "dark": "#93A7C7", "note": "codes, meta, captions (≥4.5:1 on paper)" },
    "line":        { "light": "#1F3F86", "dark": "#9DC1F5", "note": "dimension lines, labels, figure boxes, links" },
    "rule":        { "light": "rgba(24,35,58,0.25)", "dark": "rgba(230,238,250,0.22)", "note": "table row rules" },
    "grid-major":  { "light": "rgba(31,63,134,0.06)", "dark": "rgba(157,193,245,0.10)" },
    "grid-minor":  { "light": "rgba(31,63,134,0.035)", "dark": "rgba(157,193,245,0.05)" },
    "fill-1":      { "light": "#E4E9F3", "dark": "#1A3563", "note": "plate / bar / highlight fill" },
    "fill-2":      { "light": "#C9D5EC", "dark": "#24467E", "note": "stronger plate / bar fill" },
    "fill-3":      { "light": "#DCE4F2", "dark": "#1E3C6E" },
    "redline":     { "light": "#B63A26", "dark": "#FF8A6B", "note": "revision notes, pending, crosshair, in-progress" },
    "redline-tint":{ "light": "rgba(200,64,42,0.04)", "dark": "rgba(255,138,107,0.08)" },
    "focus":       { "light": "#18233A", "dark": "#E6EEFA" }
  },
  "font": {
    "display": "Archivo, 'Arial Narrow', sans-serif — weight 800–850, font-stretch 112–118%, uppercase, letter-spacing -0.03em",
    "body": "'IBM Plex Sans', system-ui, sans-serif",
    "mono": "'IBM Plex Mono', ui-monospace, monospace",
    "files": "self-hosted woff2 (subset latin): Archivo variable (wdth 62–125, wght 100–900), IBM Plex Sans 400/500/600, IBM Plex Mono 400/500/600"
  },
  "size": {
    "display-xl": "clamp(56px, 9vw, 112px)",
    "display-l":  "clamp(44px, 6vw, 72px)",
    "display-m":  "clamp(26px, 3vw, 34px)",
    "display-s":  "clamp(20px, 2vw, 28px)",
    "lead":       "17px (role line on Sheet 01: 26px Archivo 500, not uppercase)",
    "body":       "15–16px, line-height 1.6–1.65",
    "small":      "14px",
    "label":      "12px mono, letter-spacing .12em, uppercase, color line",
    "code":       "11–12px mono",
    "micro":      "9–10px mono, letter-spacing .1em (title-block captions, zone numbers)"
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "40px", "8": "48px", "9": "56px", "10": "72px" },
  "sheet": {
    "max-width": "1320px",
    "outer-padding": "32px 24px (desk around the sheet); 0 on phone (the sheet is the screen)",
    "frame": "2px ink outer, 10px gap, 1px ink inner (phone: the 2px outer only)",
    "content-padding": "56px desktop, 20px phone",
    "grid": "16px minor / 80px major",
    "tab-bar-height": "62px"
  },
  "border": { "strong": "2px ink", "normal": "1.5px ink", "thin": "1px ink", "dashed-note": "1.5px dashed redline", "box": "1.5px line" },
  "radius": { "all": "0 — drawings have square corners; only balloons and stamps are circles" },
  "shadow": { "lift": "6px 6px 0 ink (hard offset, no blur)", "plate": "7px 7px 0 ink" },
  "motion": {
    "ease-plot": "cubic-bezier(.7,0,.2,1)",
    "ease-out":  "cubic-bezier(.2,.7,.1,1)",
    "ease-pop":  "cubic-bezier(.34,1.7,.5,1)",
    "fast": "150ms", "normal": "250ms", "draw": "600ms", "wipe": "800ms",
    "spec": "design/motion.md"
  },
  "breakpoints": { "phone": "< 768px", "tablet": "768–1023px", "desktop": ">= 1024px" }
}
